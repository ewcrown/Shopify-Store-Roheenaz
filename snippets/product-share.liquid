{% comment %}
  Product share button + fallback panel (copy link, social links).
  @param product - Product to share
  @param share_id - Optional unique id for this instance (e.g. block.id)
{% endcomment %}
{% assign share_id = share_id | default: 'product-share' %}
{% if product %}
  {% assign full_url = request.origin | append: product.url %}
  {% assign share_title = product.title | escape %}
{% else %}
  {% assign full_url = request.origin | append: request.path %}
  {% assign share_title = page_title | escape %}
{% endif %}

<div class="product-share" data-product-share>
  <div class="product-share__trigger">
    <button type="button" class="product-share__button button" aria-expanded="false" aria-controls="SharePanel-{{ share_id }}" data-share-trigger aria-label="{{ 'general.share.share' | t | default: 'Share' }}">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
        <path d="M11.1002 3C7.45057 3.00657 5.53942 3.09617 4.31806 4.31754C3 5.63559 3 7.75698 3 11.9997C3 16.2425 3 18.3639 4.31806 19.6819C5.63611 21 7.7575 21 12.0003 21C16.243 21 18.3644 21 19.6825 19.6819C20.9038 18.4606 20.9934 16.5494 21 12.8998" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M20.9995 6.02513L20 6.0226C16.2634 6.01315 14.3951 6.00843 13.0817 6.9525C12.6452 7.26623 12.2622 7.64829 11.9474 8.08396C11 9.39499 11 11.2633 11 14.9998M20.9995 6.02513C21.0062 5.8625 20.9481 5.6989 20.8251 5.55317C20.0599 4.6467 18.0711 2.99984 18.0711 2.99984M20.9995 6.02513C20.9934 6.17096 20.9352 6.316 20.8249 6.44665C20.0596 7.35294 18.0711 8.99984 18.0711 8.99984" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="visually-hidden">{{ 'general.share.share' | t | default: 'Share' }}</span>
    </button>
  </div>
  <div id="SharePanel-{{ share_id }}" class="product-share__fallback" data-share-fallback aria-hidden="true">
    <div class="product-share__header">
      <h2 class="product-share__title"><span>{{ 'general.share.share' | t | default: 'Share' }}</span></h2>
      <button type="button" class="product-share__close" aria-label="{{ 'general.share.close' | t | default: 'Close' }}" data-share-close>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20" height="20"><path d="M38.98 6.97a2 2 0 0 0-1.41.59L24 21.17 10.41 7.59a2 2 0 1 0-2.83 2.82L21.17 24 7.59 37.59a2 2 0 1 0 2.82 2.82L24 26.83 37.59 40.41a2 2 0 1 0 2.82-2.82L26.83 24 40.41 10.41a2 2 0 0 0-1.41-3.44z"/></svg>
      </button>
    </div>
    <div class="product-share__content">
      <label class="product-share__label" for="ShareUrl-{{ share_id }}">{{ 'general.share.copy_link' | t | default: 'Copy link' }}</label>
      <div class="product-share__copy-group">
        <input type="text" class="product-share__input field__input" id="ShareUrl-{{ share_id }}" value="{{ full_url }}" readonly data-share-url>
        <button type="button" class="button button--primary product-share__copy-btn" data-share-copy>{{ 'general.share.copy_link' | t | default: 'Copy link' }}</button>
      </div>
      <span class="product-share__message hidden" data-share-message role="status" aria-live="polite">{{ 'general.share.copied' | t | default: 'Link copied to clipboard!' }}</span>
      <div class="product-share__social">
        <label class="product-share__label">{{ 'general.share.share' | t | default: 'Share' }}</label>
        <ul class="product-share__list">
          <li class="product-share__item">
            <a class="product-share__link product-share__link--facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ full_url | url_encode }}" title="Facebook" rel="noopener noreferrer nofollow" target="_blank">
              <svg class="icon" viewBox="0 0 320 512" aria-hidden="true"><path fill="currentColor" d="M279.14 288l14.22-92.66h-88.91v-60.13c0-25.35 12.42-50.06 52.24-50.06h40.42V6.26S260.43 0 225.36 0c-73.22 0-121.08 44.38-121.08 124.72v70.62H22.89V288h81.39v224h100.17V288z"/></svg>
            </a>
          </li>
          <li class="product-share__item">
            <a class="product-share__link product-share__link--twitter" href="https://twitter.com/share?text={{ share_title | url_encode }}&amp;url={{ full_url | url_encode }}" title="Twitter" rel="noopener noreferrer nofollow" target="_blank">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </li>
          <li class="product-share__item">
            <a class="product-share__link product-share__link--pinterest" href="https://pinterest.com/pin/create/button/?url={{ full_url | url_encode }}&amp;media={{ product.featured_image | image_url: width: 1024 }}&amp;description={{ share_title | url_encode }}" title="Pinterest" rel="noopener noreferrer nofollow" target="_blank">
              <svg class="icon" viewBox="0 0 17 18" aria-hidden="true"><path fill="currentColor" d="M8.48.58a8.42 8.42 0 0 1 5.9 2.45 8.42 8.42 0 0 1 1.33 10.08 8.28 8.28 0 0 1-7.23 4.16 8.5 8.5 0 0 1-2.37-.32c.42-.68.7-1.29.85-1.8l.59-2.29c.14.28.41.52.8.73.4.2.8.31 1.24.31.87 0 1.65-.25 2.34-.75a4.87 4.87 0 0 0 1.6-2.05 7.3 7.3 0 0 0 .56-2.93c0-1.3-.5-2.41-1.49-3.36a5.27 5.27 0 0 0-3.8-1.43c-.93 0-1.8.16-2.58.48A5.23 5.23 0 0 0 2.85 8.6c0 .75.14 1.41.43 1.98.28.56.7.96 1.27 1.2.1.04.19.04.26 0 .07-.03.12-.1.15-.2l.18-.68c.05-.15.02-.3-.11-.45a2.35 2.35 0 0 1-.57-1.63A3.96 3.96 0 0 1 8.6 4.8c1.09 0 1.94.3 2.54.89.61.6.92 1.37.92 2.32 0 .8-.11 1.54-.33 2.21a3.97 3.97 0 0 1-.93 1.62c-.4.4-.87.6-1.4.6-.43 0-.78-.15-1.06-.47-.27-.32-.36-.7-.26-1.13a111.14 111.14 0 0 1 .47-1.6l.18-.73c.06-.26.09-.47.09-.65 0-.36-.1-.66-.28-.89-.2-.23-.47-.35-.83-.35-.45 0-.83.2-1.13.62-.3.41-.46.93-.46 1.56a4.1 4.1 0 0 0 .18 1.15l.06.15c-.6 2.58-.95 4.1-1.08 4.54-.12.55-.16 1.2-.13 1.94a8.4 8.4 0 0 1-5-7.65c0-2.3.81-4.28 2.44-5.9A8.04 8.04 0 0 1 8.48.57z"/></svg>
            </a>
          </li>
          <li class="product-share__item">
            <a class="product-share__link product-share__link--whatsapp" href="https://wa.me/?text={{ share_title | url_encode }}%20{{ full_url | url_encode }}" title="WhatsApp" rel="noopener noreferrer nofollow" target="_blank">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </a>
          </li>
          <li class="product-share__item">
            <a class="product-share__link product-share__link--email" href="mailto:?subject={{ share_title | url_encode }}&amp;body={{ full_url | url_encode }}" title="Email" rel="noopener noreferrer nofollow">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .product-share { position: relative; }
  .product-share__trigger { flex-shrink: 0; }
  .product-share__button {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    background: none;
    border: none;
    color: currentColor;
    cursor: pointer;
    font-size: inherit;
    font-family: inherit;
  }
  .product-share__button:hover { opacity: 0.8; }
  .product-share__icon { width: 1.125rem; height: 1.125rem; }
  .product-share__fallback {
    display: none;
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.5rem;
    min-width: 500px;
    padding: 1rem;
    background: var(--color-background, #fff);
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.12);
    z-index: 10;
  }
  .product-share__fallback.is-open { display: block; }
  .product-share__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .product-share__title { margin: 0; font-size: 1rem; font-weight: 600; }
  .product-share__close {
    padding: 0.25rem;
    background: none;
    border: none;
    cursor: pointer;
    color: currentColor;
  }
  .product-share__close:hover { opacity: 0.7; }
  .product-share__label { display: block; font-size: 0.875rem; margin-bottom: 0.35rem; color: var(--color-foreground); }
  .product-share__copy-group { display: flex; gap: 0.5rem; margin-bottom: 0.5rem; }
  .product-share__input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem;
    border: 1px solid rgba(0,0,0,0.2);
    border-radius: 4px;
    font-size: 0.875rem;
  }
  .product-share__copy-btn { flex-shrink: 0; white-space: nowrap; }
  .product-share__message.hidden { display: none !important; }
  .product-share__message:not(.hidden) { font-size: 0.875rem; color: var(--color-primary); margin-top: 0.25rem; }
  .product-share__social { margin-top: 1rem; padding-top: 0.75rem; border-top: 1px solid rgba(0,0,0,0.08); }
  .product-share__list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .product-share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: currentColor;
  }
  .product-share__link:hover { opacity: 0.8; }
  .product-share__link .icon { width: 1.125rem; height: 1.125rem; }
</style>

<script>
  (function() {
    document.querySelectorAll('[data-product-share]').forEach(function(el) {
      var trigger = el.querySelector('[data-share-trigger]');
    var fallback = el.querySelector('[data-share-fallback]');
    var closeBtn = el.querySelector('[data-share-close]');
    var copyBtn = el.querySelector('[data-share-copy]');
    var urlInput = el.querySelector('[data-share-url]');
    var messageEl = el.querySelector('[data-share-message]');
    function open() { fallback.classList.add('is-open'); fallback.setAttribute('aria-hidden', 'false'); if (trigger) trigger.setAttribute('aria-expanded', 'true'); }
    function close() { fallback.classList.remove('is-open'); fallback.setAttribute('aria-hidden', 'true'); if (trigger) trigger.setAttribute('aria-expanded', 'false'); }
    function copyUrl() {
      if (!urlInput) return;
      urlInput.select();
      urlInput.setSelectionRange(0, 99999);
      try {
        navigator.clipboard.writeText(urlInput.value);
        if (messageEl) { messageEl.classList.remove('hidden'); setTimeout(function() { messageEl.classList.add('hidden'); }, 2500); }
      } catch (e) {}
    }
    if (trigger) trigger.addEventListener('click', function(e) { e.preventDefault(); e.stopPropagation(); fallback.classList.contains('is-open') ? close() : open(); });
    if (closeBtn) closeBtn.addEventListener('click', close);
    if (copyBtn) copyBtn.addEventListener('click', copyUrl);
    document.addEventListener('click', function(e) { if (el.contains(e.target)) return; close(); });
    });
  })();
</script>
