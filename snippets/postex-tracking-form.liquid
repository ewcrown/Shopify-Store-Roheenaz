<!-- PostEx Tracking Form for Shopify - FINAL STABLE (Exact Match Only) -->
<div class="postex-tracker-container">
  <div class="postex-header">
    <h3>Track Your Order</h3>
    <p>Please enter your 14-digit <strong>Tracking Number</strong>.</p>
  </div>

  <div class="postex-input-group">
    <input type="text" id="postex-tracking-id" placeholder="Ex: 21423800011800">
    <button id="postex-track-btn" onclick="trackPostExOrder()">Track Now</button>
  </div>

  <div id="postex-loader" style="display:none; text-align: center; margin: 20px 0;">
    <div class="spinner"></div>
    Connecting to PostEx...
  </div>

  <div
    id="postex-error"
    style="color: #d93025; background: #fce8e6; padding: 10px; border-radius: 4px; display:none; margin: 20px 0; border: 1px solid #f1c4c4; font-size: 14px;"
  ></div>

  <div id="postex-results" style="display:none;">
    <div class="status-header">
      <div style="font-size: 0.9em; color: #666;">Current Status</div>
      <div id="current-status-text" style="font-size: 1.25em; font-weight: bold; color: #2ecc71;"></div>
    </div>
    <div id="tracking-timeline" class="timeline">
      <!-- Journey steps will appear here -->
    </div>
  </div>
</div>

<style>
  .postex-tracker-container { max-width: 600px !important; margin: 30px auto; padding: 20px; border: 1px solid #e0e0e0; border-radius: 12px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; box-shadow: 0 10px 25px rgba(0,0,0,0.05); background: #fff; }
  .postex-header h3 { margin: 0 0 5px 0; font-size: 22px; color: #1a1a1a; }
  .postex-header p { color: #666; font-size: 14px; margin-bottom: 25px; }
  .postex-input-group { display: flex; gap: 8px; }
  .postex-input-group input { flex: 1; padding: 12px 15px; border: 2px solid #f0f0f0; border-radius: 8px; font-size: 16px; outline: none; min-width: 180px; }
  .postex-input-group input:focus { border-color: #000; }
  .postex-input-group button { padding: 12px 20px; background-color: #000; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 15px; min-width: fit-content; }
  .postex-input-group button:disabled { background-color: #ccc; }
  .status-header { background: #f9f9f9; padding: 20px; border-radius: 8px; margin-bottom: 25px; border-left: 6px solid #2ecc71; }
  .timeline { position: relative; margin: 20px 0; padding-left: 35px; }
  .timeline::before { content: ''; position: absolute; left: 10px; top: 5px; bottom: 5px; width: 2px; background: #eee; }
  .timeline-item { position: relative; margin-bottom: 25px; }
  .timeline-item::before { content: ''; position: absolute; left: -31px; top: 4px; width: 14px; height: 14px; background: #2ecc71; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 1px #2ecc71; }
  .timeline-msg { font-weight: 600; color: #333; }
  .timeline-date { font-size: 12px; color: #888; margin-top: 4px; }
  .spinner { border: 3px solid #f3f3f3; border-top: 3px solid #2ecc71; border-radius: 50%; width: 20px; height: 20px; display: inline-block; animation: spin 1s linear infinite; vertical-align: middle; margin-right: 10px; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
</style>

<script>
  async function trackPostExOrder() {
    const inputField = document.getElementById('postex-tracking-id');
    let trackingNumber = inputField.value.trim();
    const btn = document.getElementById('postex-track-btn');
    const resultsDiv = document.getElementById('postex-results');
    const loader = document.getElementById('postex-loader');
    const errorDiv = document.getElementById('postex-error');
    const timeline = document.getElementById('tracking-timeline');
    const statusText = document.getElementById('current-status-text');

    if (!trackingNumber) {
      alert('Please enter a tracking number.');
      return;
    }

    resultsDiv.style.display = 'none';
    errorDiv.style.display = 'none';
    loader.style.display = 'block';
    btn.disabled = true;

    try {
      const myHeaders = new Headers();
      myHeaders.append(
        'token',
        'NTU0OWMyYmE1YmNiNGZlNTkxNDI1NzJmYzhmZTY4MmY6OThkNGQwMjI5NjM5NDk2YWJiOGVhZTQ2ODU1NmY5NmY'
      );
      
      const response = await fetch(`https://api.postex.pk/services/integration/api/order/v1/track-order/${trackingNumber}`, {
        method: 'GET',
        headers: myHeaders,
      });
      
      const result = await response.json();

      loader.style.display = 'none';
      btn.disabled = false;

      if (result.statusCode === '200' && result.dist) {
        resultsDiv.style.display = 'block';
        statusText.innerText = result.dist.transactionStatus || 'In Process';

        timeline.innerHTML = '';
        const history = result.dist.transactionStatusHistory;

        if (history && history.length > 0) {
          [...history].reverse().forEach((item) => {
            const step = document.createElement('div');
            step.className = 'timeline-item';
            step.innerHTML = `
            <div class="timeline-msg">${item.transactionStatusMessage}</div>
            <div class="timeline-date">Code: ${item.transactionStatusMessageCode}</div>
          `;
            timeline.appendChild(step);
          });
        } else {
          timeline.innerHTML = '<p style="font-size:14px; color:#666;">Shipment created. History will update soon.</p>';
        }
      } else {
        errorDiv.innerText = 'Tracking number not found. Check your receipt for the 14-digit ID.';
        errorDiv.style.display = 'block';
      }
    } catch (error) {
      loader.style.display = 'none';
      btn.disabled = false;
      errorDiv.innerText = 'Error connecting to PostEx server.';
      errorDiv.style.display = 'block';
    }
  }
</script>