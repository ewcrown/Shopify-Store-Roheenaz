{%- comment -%}
  Snippet: snippets/predictive-search.liquid
  Usage in header: {% render 'predictive-search' %}
  What it does: Predictive product search that renders a grid-style results block
                (title + items + "More Results") and optionally mirrors a small grid
                into [data-popular-searches]. Robust money formatting & quiet aborts.
{%- endcomment -%}

<div id="HeaderPredictiveSearch"
     class="predictive-search w-full md:w-2/3 flex justify-center items-center"
     role="combobox"
     aria-haspopup="listbox"
     aria-owns="PredictiveResults"
     aria-expanded="false">

  <form action="{{ routes.search_url }}" method="get" role="search" class="predictive-search__form" autocomplete="off" novalidate>
    <input id="SearchInput"
           class="predictive-search__input"
           name="q"
           type="search"
           placeholder="Search products"
           aria-label="Search"
           aria-autocomplete="list"
           aria-controls="PredictiveResults"
           autocapitalize="off"
           autocomplete="off"
           autocorrect="off"
           spellcheck="false" />

    <input type="hidden" name="type" value="product" />
    <input type="hidden" name="options[prefix]" value="last" />

    <button type="submit" class="predictive-search__submit" aria-label="Search">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 4a6 6 0 104.472 10.06l4.734 4.734 1.414-1.415-4.734-4.734A6 6 0 0010 4zm-4 6a4 4 0 118 0 4 4 0 01-8 0z"/></svg>
    </button>
  </form>
</div>

<style>
  .predictive-search { position: relative; max-width: 920px; width: 100%; }
  .predictive-search__form { display:flex; gap:.5rem; align-items:center; width:100%; }
  .predictive-search__input { width:100%; padding:.6rem .8rem; border:1px solid rgba(0,0,0,.14); border-radius:12px; font-size:14px; }
  .predictive-search__input:focus { outline: 2px solid rgba(0,0,0,.2); outline-offset: 2px; }
  .predictive-search__submit { background:transparent; border:0; cursor:pointer; display:grid; place-items:center; padding:.35rem; border-radius:10px; }
  .predictive-search__submit:focus { outline: 2px solid rgba(0,0,0,.2); outline-offset: 2px; }

  /* We render a block, not an absolute dropdown */
  .predictive-search__results { position: static; margin-top: 0; background: transparent; border: 0; box-shadow: none; padding: 0; max-height: none; overflow: visible; }
  mark { background: #fff59d; }

  /* Optional: mirror grid into [data-popular-searches] */
  [data-popular-searches] .ps-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.75rem; width:100%; }
  @media (min-width:768px){ [data-popular-searches] .ps-grid{ grid-template-columns:repeat(4,minmax(0,1fr)); } }
  [data-popular-searches] .ps-card { display:flex; flex-direction:column; gap:.4rem; text-decoration:none; color:inherit; background:#fff; border:1px solid rgba(0,0,0,.08); border-radius:12px; padding:.6rem; min-width:0; transition:transform .12s ease, box-shadow .12s ease; }
  [data-popular-searches] .ps-card:hover { transform:translateY(-1px); box-shadow:0 8px 20px rgba(0,0,0,.08); }
  [data-popular-searches] .ps-img { width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:10px; background:#f6f6f6; }
  [data-popular-searches] .ps-title { font-weight:600; font-size:.95rem; line-height:1.25; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  [data-popular-searches] .ps-vendor { font-size:.8rem; opacity:.65; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  [data-popular-searches] .ps-price { font-size:.9rem; font-weight:700; }
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  (function() {
    const el = document.getElementById('HeaderPredictiveSearch');
    if (!el) return;

    const rootUrl = {{ routes.root_url | json }};
    const searchPageUrl = {{ routes.search_url | json }};
    const input = el.querySelector('#SearchInput');
    const results = document.getElementById('PredictiveResults');

    // Optional mirror target under your "Popular Searches" wrapper
    const popular = document.querySelector('[data-popular-searches]');
    const popularItemsWrap = popular ? (popular.querySelector('.flex.items-center.flex-wrap') || popular.querySelector('.flex.items-center') || popular.querySelector('div:last-child')) : null;

    let aborter = null;
    let lastQuery = '';
    let activeIndex = -1;
    let itemsFlat = [];

    const debounce = (fn, wait=200) => { let t; return (...args)=>{ clearTimeout(t); t=setTimeout(()=>fn(...args), wait); }; };

    function clearResults() {
      results.innerHTML='';
      results.hidden = true;
      el.setAttribute('aria-expanded','false');
      itemsFlat=[]; activeIndex=-1;

      if (popularItemsWrap && popularItemsWrap.dataset.psInjected === '1') {
        popularItemsWrap.innerHTML='';
        popularItemsWrap.dataset.psInjected='0';
      }
    }

    // ==== MONEY HELPERS ====
    const RAW_MONEY_FORMAT = {{ shop.money_format | json }};

    {% raw %}
    const stripTags = (s) => String(s || '').replace(/<[^>]*>/g, '');
    const tokenRx = (name) => new RegExp('\\{\\{\\s*' + name + '\\s*\\}\\}', 'i');

    function buildNumberFormats(cents) {
      const value = (Number(cents) || 0) / 100;
      return {
        with2: value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
        with0: Math.round(value).toLocaleString('en-US'),
        de2:   value.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 2 }),
        de0:   Math.round(value).toLocaleString('de-DE'),
        apos2: value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, "'"),
      };
    }

    // Returns plain text like "Rs. 13,450"
    function formatMoneyText(cents) {
      let format = stripTags(RAW_MONEY_FORMAT);
      const n = buildNumberFormats(cents);
      if (!format) return 'Rs. ' + n.de2;
      console.log("==>",n)

      if (tokenRx('amount_no_decimals_with_comma_separator').test(format)) return format.replace(tokenRx('amount_no_decimals_with_comma_separator'), n.de0);
      if (tokenRx('amount_with_comma_separator').test(format))             return format.replace(tokenRx('amount_with_comma_separator'), n.de2);
      if (tokenRx('amount_with_apostrophe_separator').test(format))        return format.replace(tokenRx('amount_with_apostrophe_separator'), n.apos2);
      if (tokenRx('amount_no_decimals').test(format))                      return format.replace(tokenRx('amount_no_decimals'), n.de2);
      if (tokenRx('amount').test(format))                                  return format.replace(tokenRx('amount'), n.with2);

      return 'Rs. ' + n.de2;
    }
    {% endraw %}

    // ==== OPTIONAL: mirror small grid below into [data-popular-searches] ====
    function renderGridProducts(products, query){
      if (!popularItemsWrap) return;

      const grid = document.createElement('div');
      grid.className = 'ps-grid';

      products.slice(0,8).forEach((p)=>{
        const a = document.createElement('a');
        a.className='ps-card';
        a.href = p.url || p.url_with_variant || '#';

        const imgUrl = p.image ? (typeof p.image === 'string' ? p.image : p.image.url)
                               : (p.featured_image ? p.featured_image.url : null);
        if (imgUrl){
          const img = document.createElement('img');
          img.loading='lazy'; img.decoding='async';
          img.src = imgUrl.replace('http:','https:');
          img.alt = p.title || '';
          img.className = 'ps-img';
          a.appendChild(img);
        }

        const title = document.createElement('div');
        title.className='ps-title';
        title.textContent = p.title || '';
        a.appendChild(title);

        if (p.vendor){
          const vendor = document.createElement('div');
          vendor.className='ps-vendor';
          vendor.textContent = p.vendor;
          a.appendChild(vendor);
        }

        if (p.price){
          const price = document.createElement('div');
          price.className = 'ps-price';
          price.textContent = formatMoneyText(p.price); // plain text e.g. "Rs. 13,450"
          a.appendChild(price);
        }

        grid.appendChild(a);
      });

      popularItemsWrap.innerHTML='';
      popularItemsWrap.appendChild(grid);
      popularItemsWrap.dataset.psInjected='1';
    }

    // ==== Main results renderer (your requested structure) ====
    function renderResults(payload, query) {
      const res = payload && payload.resources && payload.resources.results || {};
      const products = res.products || [];

      results.innerHTML = '';
      itemsFlat = [];

      const wrapper = document.createElement('div');
      wrapper.setAttribute('data-result','');

      // Title
      const titleWrap = document.createElement('div');
      titleWrap.className = 'text-2xl text-[#999] mt-4 md:mt-9 mb-2 md:mb-7 text-center';

      const titleSpan = document.createElement('span');
      titleSpan.setAttribute('data-message','');
      titleSpan.setAttribute('data-results-title','Results for');
      titleSpan.setAttribute('data-no-results','No result for');
      titleSpan.textContent = products.length ? 'Results for' : 'No result for';

      const qSpan = document.createElement('span');
      qSpan.className = 'text-black';
      qSpan.setAttribute('data-query','');
      qSpan.textContent = query;

      titleWrap.appendChild(titleSpan);
      titleWrap.appendChild(document.createTextNode(' "'));
      titleWrap.appendChild(qSpan);
      titleWrap.appendChild(document.createTextNode('"'));
      wrapper.appendChild(titleWrap);

      // Grid
      const grid = document.createElement('div');
      grid.className = 'grid gap-x-3 md:gap-x-6 md:auto-rows-0 grid-rows-1 grid-cols-2 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 3xl:grid-cols-7 overflow-y-hidden';
      grid.setAttribute('data-search-items-wrapper','');

      products.slice(0,12).forEach((p)=>{
        const item = document.createElement('div');
        item.setAttribute('data-search-item','');

        const a = document.createElement('a');
        a.href = p.url || p.url_with_variant || '#';
        a.className = 'mb-3 flex flex-col group';
        a.setAttribute('data-product-id', p.id || '');

        // Image
        const imgWrap = document.createElement('div');
        imgWrap.className = 'mb-3 w-full';
        imgWrap.style.setProperty('--aspect-ratio','3/4');

        const imgUrl = p.image ? (typeof p.image === 'string' ? p.image : p.image.url)
                               : (p.featured_image ? p.featured_image.url : null);
        if (imgUrl){
          const img = document.createElement('img');
          img.className = 'transition-opacity opacity-0 opacity-100';
          img.loading = 'lazy';
          img.src = imgUrl.replace('http:','https:');
          img.alt = p.title || '';
          imgWrap.appendChild(img);

          if (p.available === false) {
            const tag = document.createElement('span');
            tag.className = 'flex prod__tag prod__tag--soldout';
            tag.textContent = 'Sold Out';
            imgWrap.appendChild(tag);
          }
        }

        a.appendChild(imgWrap);

        // Text: title + price
        const info = document.createElement('div');
        info.className = 'md:ml-0 w-full';

        const title = document.createElement('p');
        title.className = 'font-medium group-hover:text-color-primary-darker';
        title.textContent = p.title || '';
        info.appendChild(title);

        const priceWrap = document.createElement('div');
        priceWrap.className = 'mt-1';
        if (p.price) {
          priceWrap.textContent = formatMoneyText(p.price); // plain "Rs. 13,450"
        }
        info.appendChild(priceWrap);

        a.appendChild(info);
        item.appendChild(a);
        grid.appendChild(item);

        // For keyboard nav
        itemsFlat.push(a);
      });

      wrapper.appendChild(grid);

      // "More results"
      if (query && products.length) {
        const moreWrap = document.createElement('div');
        moreWrap.className = 'flex justify-center mt-10';
        const more = document.createElement('a');
        more.className = 'sf__btn sf__btn-primary';
        more.href = searchPageUrl + '?type=product&options[unavailable_products]=last&options[prefix]=last&q=' + encodeURIComponent(query);
        more.setAttribute('data-more-result','');
        more.textContent = 'More Results';
        moreWrap.appendChild(more);
        wrapper.appendChild(moreWrap);
      }

      results.appendChild(wrapper);
      results.hidden = false;
      el.setAttribute('aria-expanded','true');

      // Mirror into Popular Searches (optional)
      if (products.length) {
        renderGridProducts(products, query);
      } else if (popularItemsWrap) {
        popularItemsWrap.innerHTML='';
        popularItemsWrap.dataset.psInjected='0';
      }
    }

    // ==== Utils ====
    function escapeHtml(s){return String(s||'').replace(/[&<>"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
    function escapeRegExp(s){return String(s||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
    function highlight(text, query) {
      if (!query) return escapeHtml(text);
      try { return escapeHtml(text).replace(new RegExp('(' + escapeRegExp(query) + ')','ig'), '<mark>$1</mark>'); }
      catch { return escapeHtml(text); }
    }

    // ==== Quiet, debounced fetch with abort handling ====
    const fetchSuggestions = debounce(async (q) => {
      if (!q || q.length < 2) { clearResults(); lastQuery = q; return; }
      if (q === lastQuery && !results.hidden) return;
      lastQuery = q;

      if (aborter) { try { aborter.abort(); } catch {} aborter = null; }
      const controller = new AbortController();
      aborter = controller;

      const url = `${rootUrl}search/suggest.json?q=${encodeURIComponent(q)}&resources[type]=product&resources[limit]=10&resources[options][unavailable_products]=last&resources[options][fields]=title,vendor,product_type,variants.title,variants.sku,tag,body`;

      try {
        const resp = await fetch(url, {
          headers: { 'Accept': 'application/json' },
          signal: controller.signal,
          credentials: 'same-origin',
          cache: 'no-store'
        });
        if (controller.signal.aborted) return;
        if (!resp.ok) throw new Error('Network');
        const data = await resp.json();
        renderResults(data, q);
      } catch (e) {
        if (e && e.name === 'AbortError') return; // ignore expected cancels
        clearResults();
      } finally {
        if (aborter === controller) aborter = null;
      }
    }, 200);

    // Mute console spam from fetch hijackers on abort
    window.addEventListener('unhandledrejection', (e) => {
      if (e?.reason?.name === 'AbortError') e.preventDefault();
    });

    // Events
    input.addEventListener('input', (e)=> fetchSuggestions(e.target.value));
    input.addEventListener('focus', (e)=> fetchSuggestions(e.target.value));
    document.addEventListener('click', (e)=> { if (!el.contains(e.target)) clearResults(); });

    // Keyboard nav (ArrowUp/Down + Esc)
    input.addEventListener('keydown', (e)=>{
      if (results.hidden) return;
      const max = itemsFlat.length - 1;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(max, activeIndex + 1);
        itemsFlat[activeIndex]?.focus({preventScroll:true});
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(0, activeIndex - 1);
        itemsFlat[activeIndex]?.focus({preventScroll:true});
      } else if (e.key === 'Escape') {
        clearResults();
      }
    });
  })();
});
</script>

<noscript>
  <style>#PredictiveResults{display:none!important}</style>
</noscript>