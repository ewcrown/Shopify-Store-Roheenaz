<style>
   .look-slider{
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding:0 40px;
}
  .look-slider img{
display:block;
max-width:100%;
height:auto;
margin-bottom:30px;
}
</style>


<div class="look-slider wrapper section-padding" style="text-align:center;">

  <div class="splide" role="group" aria-label="Lookbook Slider">
    <div class="splide__track">
      <ul class="splide__list">

        {% assign lookbook_images = page.metafields.custom.img.value %}

        {% if lookbook_images %}
          {% for img in lookbook_images %}
            <li class="splide__slide">
              <div>
                <img
                  src="{{ img | image_url: width: 1200 }}"
                  alt="Esmel lookbook {{ forloop.index }}"
                  loading="lazy"
                  width="100%"
                  height="auto">
              </div>
            </li>
          {% endfor %}
        {% else %}
          <p>No images added yet. Add them in metafields → custom.img</p>
        {% endif %}

      </ul>
    </div>
  </div>

</div>

 
<script>
  var splide = new Splide( '.splide' );
splide.mount();
</script>



 
