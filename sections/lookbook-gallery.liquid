<div class="lookbook-ai container-fluid ">
  {% for block in section.blocks %}
      {% if block.settings.image != blank %}
        <a href="{{ block.settings.img_url }}">
   <img 
src="{{ block.settings.image | image_url: width: 800 }}"
  loading="lazy"
  class="lookbook-ai-img"
  width=""
  height=""
>

      </a>
    {% endif %}
  {% endfor %}
</div>
<style>
    .lookbook-ai {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-top:20px;
}

.lookbook-ai a {
  display: block;
}

.lookbook-ai-img {
  width: 100%;
  height: 480px;
  display: block;
  object-fit: cover;
  border-radius:6px;
}
/* Tablet */
@media (max-width: 1024px) {
  .lookbook-ai {
    grid-template-columns: repeat(3, 1fr);
  }
  .lookbook-ai-img{
      height: auto;
}
}

/* Mobile */
@media (max-width: 768px) {
  .lookbook-ai {
    grid-template-columns: repeat(2, 1fr);
  }

}

/* Small Mobile */
@media (max-width: 480px) {
  .lookbook-ai {
    grid-template-columns: 1fr;
  }
}

</style>
{% schema %}
{
  "name": "Lookbook Gallery",
  "blocks": [
    {
      "type": "image",
      "name": "Lookbook Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Select Image"
        },
          {
          "type": "url",
          "id": "img_url",
          "label": "Url"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook Gallery"
    }
  ]
}
{% endschema %}