
<section class="media-grid-section">
<div class="section section--full-width-margin section--page-width">
    <div class="media-grid-container">

    {% comment %} --- Left Slot --- {% endcomment %}
    <div class="media-item">
        {%- if section.settings.left_video != blank -%}
        {{ section.settings.left_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
        {%- elsif section.settings.left_image != blank -%}
        <img src="{{ section.settings.left_image | img_url: 'master' }}" alt="{{ section.settings.left_image.alt }}">
        {%- endif -%}
    </div>

    {% comment %} --- Center Slot --- {% endcomment %}
    <div class="media-item">
        {%- if section.settings.center_video != blank -%}
        {{ section.settings.center_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
        {%- elsif section.settings.center_image != blank -%}
        <img src="{{ section.settings.center_image | img_url: 'master' }}" alt="{{ section.settings.center_image.alt }}">
        {%- endif -%}
    </div>

    {% comment %} --- Right Slot --- {% endcomment %}
    <div class="media-item">
        {%- if section.settings.right_video != blank -%}
        {{ section.settings.right_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
        {%- elsif section.settings.right_image != blank -%}
        <img src="{{ section.settings.right_image | img_url: 'master' }}" alt="{{ section.settings.right_image.alt }}">
        {%- endif -%}
    </div>

    </div>
</div>
</section>

{% schema %}
{
"name": "Media Triple Grid Pro",
"settings": [
    {
    "type": "header",
    "content": "Left Slot"
    },
    {
    "type": "image_picker",
    "id": "left_image",
    "label": "Left Image"
    },
    {
    "type": "video",
    "id": "left_video",
    "label": "Left Video"
    },
    {
    "type": "header",
    "content": "Center Slot"
    },
    {
    "type": "image_picker",
    "id": "center_image",
    "label": "Center Image"
    },
    {
    "type": "video",
    "id": "center_video",
    "label": "Center Video"
    },
    {
    "type": "header",
    "content": "Right Slot"
    },
    {
    "type": "image_picker",
    "id": "right_image",
    "label": "Right Image"
    },
    {
    "type": "video",
    "id": "right_video",
    "label": "Right Video"
    }
],
"presets": [
    {
    "name": "Media Triple Grid Pro"
    }
]
}
{% endschema %}