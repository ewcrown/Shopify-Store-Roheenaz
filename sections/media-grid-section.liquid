
<section class="media-grid-section">
  <div class="section section--full-width-margin section--page-width">
    <div class="splide media-grid-splide" id="media-grid-splide-{{ section.id }}" aria-label="Media grid">
      <div class="splide__track">
        <ul class="splide__list media-grid-splide__list">

          {% comment %} --- Left Slot --- {% endcomment %}
          <li class="splide__slide{% if section.settings.left_video != blank %} splide__slide--has-video{% endif %}">
            <div class="media-item">
              {%- if section.settings.left_video != blank -%}
                {{ section.settings.left_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
              {%- elsif section.settings.left_image != blank -%}
                <img src="{{ section.settings.left_image | image_url: width: 800 }}" alt="{{ section.settings.left_image.alt | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </li>

          {% comment %} --- Center Slot --- {% endcomment %}
          <li class="splide__slide{% if section.settings.center_video != blank %} splide__slide--has-video{% endif %}">
            <div class="media-item">
              {%- if section.settings.center_video != blank -%}
                {{ section.settings.center_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
              {%- elsif section.settings.center_image != blank -%}
                <img src="{{ section.settings.center_image | image_url: width: 800 }}" alt="{{ section.settings.center_image.alt | escape }}" loading="eager">
              {%- endif -%}
            </div>
          </li>

          {% comment %} --- Right Slot --- {% endcomment %}
          <li class="splide__slide{% if section.settings.right_video != blank %} splide__slide--has-video{% endif %}">
            <div class="media-item">
              {%- if section.settings.right_video != blank -%}
                {{ section.settings.right_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: 'custom-video' }}
              {%- elsif section.settings.right_image != blank -%}
                <img src="{{ section.settings.right_image | image_url: width: 800 }}" alt="{{ section.settings.right_image.alt | escape }}" loading="eager">
              {%- endif -%}
            </div>
          </li>

        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Same pattern as featured collection (rohe-feature-product): section-scoped list, no global .media-grid-container */
  .media-grid-splide .media-grid-splide__list { display: flex; height: 500px; }
  .media-grid-splide .splide__slide { height: 500px; }
  .media-grid-splide .media-item {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    background: #f5f5f5;
  }
  .media-grid-splide .media-item img,
  .media-grid-splide .media-item .custom-video,
  .media-grid-splide .media-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }
  @media (min-width: 750px) {
    .media-grid-splide .splide__track { overflow: visible; }
    .media-grid-splide .media-grid-splide__list { display: flex; gap: 0; transform: none !important; }
    .media-grid-splide .splide__slide { flex: 1; }
    .media-grid-splide .splide__arrows { display: none; }
    .media-grid-splide .splide__pagination { display: none; }
  }
  @media (max-width: 749px) {
    .media-grid-splide,
    .media-grid-splide .splide__track { width: 100%; }
    .media-grid-splide .media-grid-splide__list { height: 100vh; min-height: 100dvh; flex-direction: row; }
    .media-grid-splide .splide__slide { height: 100vh; min-height: 100dvh; min-width: 100%; width: 100%; box-sizing: border-box; }
    .media-grid-splide .splide__track { overflow: hidden; }
    .media-grid-splide .splide__pagination { bottom: -1.5rem; }
  }
</style>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('media-grid-splide-{{ section.id }}');
    if (!el || typeof Splide === 'undefined') return;

    // On mobile, remove slides without video so carousel only shows video slides
    if (window.innerWidth <= 749) {
      var nonVideoSlides = el.querySelectorAll('.splide__slide:not(.splide__slide--has-video)');
      nonVideoSlides.forEach(function (slide) { slide.remove(); });
      if (el.querySelectorAll('.splide__slide').length === 0) {
        el.closest('.media-grid-section').style.display = 'none';
        return;
      }
    }

    new Splide('#media-grid-splide-{{ section.id }}', {
      type: 'slide',
      perPage: 3,
      perMove: 1,
      gap: 0,
      arrows: false,
      pagination: false,
      drag: false,
      breakpoints: {
        749: {
          perPage: 1,
          perMove: 1,
          pagination: true,
          drag: true,
          padding: { right: '15%' }
        }
      }
    }).mount();
  });
</script>

{% schema %}
{
"name": "Media Triple Grid Pro",
"settings": [
    {
    "type": "header",
    "content": "Left Slot"
    },
    {
    "type": "image_picker",
    "id": "left_image",
    "label": "Left Image"
    },
    {
    "type": "video",
    "id": "left_video",
    "label": "Left Video"
    },
    {
    "type": "header",
    "content": "Center Slot"
    },
    {
    "type": "image_picker",
    "id": "center_image",
    "label": "Center Image"
    },
    {
    "type": "video",
    "id": "center_video",
    "label": "Center Video"
    },
    {
    "type": "header",
    "content": "Right Slot"
    },
    {
    "type": "image_picker",
    "id": "right_image",
    "label": "Right Image"
    },
    {
    "type": "video",
    "id": "right_video",
    "label": "Right Video"
    }
],
"presets": [
    {
    "name": "Media Triple Grid Pro"
    }
]
}
{% endschema %}