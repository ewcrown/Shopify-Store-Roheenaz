
<section class="Featured-product__collection--section" id="section-{{ section.id }}">
<div class="section section--full-width-margin section--page-width">
    {%- if section.settings.header_title != blank -%}
        <div class="Featured-product__header">
        <h2 class="Featured-product__main-title">{{ section.settings.header_title }}</h2>
        </div>
    {%- endif -%}

{%- assign collection = collections[section.settings.collection] -%}

<div class="splide" id="splide-{{ section.id }}">
    <div class="splide__track">
    <ul class="splide__list">
        {% if collection.products.size > 0 %}
        {% for product in collection.products limit: section.settings.products_to_show %}
            <li class="splide__slide">
            <div class="Featured-product__card">
                
                <div class="Featured-product__image-wrapper">
                {%- if product.available == false -%}
                    <span class="Featured-product__badge Featured-product__badge--sold-out">Sold Out</span>
                {%- elsif product.compare_at_price > product.price -%}
                    <span class="Featured-product__badge Featured-product__badge--sale">Best Seller</span>
                {%- endif -%}

                <a href="{{ product.url }}" class="Featured-product__link">
                    <img src="{{ product.featured_image | img_url: '800x' }}" class="Featured-product__img Featured-product__img--primary" alt="{{ product.title }}" loading="lazy">
                    {% if product.images[1] %}
                    <img src="{{ product.images[1] | img_url: '800x' }}" class="Featured-product__img Featured-product__img--secondary" alt="{{ product.title }}" loading="lazy">
                    {% endif %}
                </a>

                <form method="post" action="/cart/add" class="Featured-product__form">
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
                    <button type="submit" class="Featured-product__action-btn" {% unless product.available %}disabled{% endunless %}>
                    <span class="Featured-product__add-text">ADD</span>
                    {{- 'add-to-cart-icon.svg' | inline_asset_content -}}
                    </button>
                </form>
                </div>

                <div class="Featured-product__info">
                <div class="Featured-product__details">
                    <h3 class="Featured-product__title">{{ product.title }}</h3>
                    <p class="Featured-product__category">{{ collection.title }}</p>
                </div>
                <p class="Featured-product__price">{{ product.price }}</p>
                </div>

            </div>
            </li>
        {% endfor %}
        {% else %}
            {% comment %} Placeholder cards for editor preview {% endcomment %}
            <p style="text-align:center; width:100%;">Please select a collection to display products.</p>
        {% endif %}
    </ul>
    </div>
</div>

</div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function () {
const sliderId = '#splide-{{ section.id }}';
const sliderEl = document.querySelector(sliderId);

if (sliderEl) {
new Splide(sliderId, {
    type   : 'slide',
    perPage: 5,
    perMove: 1,
    gap    : '25px',
    arrows : false,
    pagination: false,
    breakpoints: {
    1200: { perPage: 3 },
    900: { perPage: 2 },
    600: { perPage: 1, padding: { right: '15%' } }
    }
}).mount();
}
});
</script>

{% schema %}
{
"name": "Roheenaz Slider",
"settings": [
{
    "type": "text",
    "id": "header_title",
    "label": "Section Title",
    "default": "Featured Collection"
},
{
    "type": "collection",
    "id": "collection",
    "label": "Select Collection"
},
{
    "type": "range",
    "id": "products_to_show",
    "min": 4,
    "max": 20,
    "step": 1,
    "default": 8,
    "label": "Total Products to Show"
}
],
"presets": [
{
    "name": "Roheenaz Slider"
}
]
}
{% endschema %}