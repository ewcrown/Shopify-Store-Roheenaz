{% comment %}
  Hero Slider – Image + Link per slide, powered by Splide JS (loaded in theme.liquid)
{% endcomment %}

<section
  class="ew-rhz-hero-slider ew-rhz-hero-slider--{{ section.id }}"
  id="ew-rhz-hero-slider-{{ section.id }}"
  aria-label="Hero Slider"
  style="--ew-rhz-slide-height: {{ section.settings.slide_height }}px; --ew-rhz-slide-height-desktop: {{ section.settings.slide_height_desktop }}px;"
>
  <div class="ew-rhz-hero-slider__viewport">
    <div class="splide" id="ew-rhz-splide-hero-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
        {% for block in section.blocks %}
          <li class="splide__slide" data-mobile-header-style="{{ block.settings.mobile_header_style | default: 'default' }}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="ew-rhz-hero-slider__link">
            {% endif %}
            <div class="ew-rhz-hero-slider__slide-content">
              {% if block.settings.mobile_image != blank and block.settings.image != blank %}
                {% comment %} Desktop image {% endcomment %}
                <img
                  class="ew-rhz-hero-slider__image ew-rhz-hero-slider__image--desktop"
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  srcset="{{ block.settings.image | image_url: width: 640 }} 640w,
                          {{ block.settings.image | image_url: width: 1024 }} 1024w,
                          {{ block.settings.image | image_url: width: 1920 }} 1920w"
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
                {% comment %} Mobile image {% endcomment %}
                <img
                  class="ew-rhz-hero-slider__image ew-rhz-hero-slider__image--mobile"
                  src="{{ block.settings.mobile_image | image_url: width: 800 }}"
                  srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                          {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                          {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
                  sizes="100vw"
                  alt="{{ block.settings.mobile_image.alt | default: block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {% elsif block.settings.image != blank %}
                <img
                  class="ew-rhz-hero-slider__image"
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  srcset="{{ block.settings.image | image_url: width: 640 }} 640w,
                          {{ block.settings.image | image_url: width: 1024 }} 1024w,
                          {{ block.settings.image | image_url: width: 1920 }} 1920w"
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% elsif block.settings.mobile_image != blank %}
                <img
                  class="ew-rhz-hero-slider__image"
                  src="{{ block.settings.mobile_image | image_url: width: 800 }}"
                  srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                          {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                          {{ block.settings.mobile_image | image_url: width: 800 }} 800w"
                  sizes="100vw"
                  alt="{{ block.settings.mobile_image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ew-rhz-hero-slider__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var splideId = 'ew-rhz-splide-hero-{{ section.id }}';
    var numSlides = {{ section.blocks.size }};
    var mounted = null;
    var lastMobile = null;

    function isMobile() {
      return window.innerWidth <= 749;
    }

    /**
     * Get the active slide's header style: 'light' | 'dark' | ''
     * Uses splide.index when provided so we get the right slide even before .is-active is set.
     */
    function getActiveSlideStyle(el, splide) {
      if (!el) return '';
      var slides = el.querySelectorAll('.splide__slide');
      if (!slides.length) return '';
      var idx = splide && typeof splide.index === 'number' ? splide.index : -1;
      var slide = idx >= 0 && idx < slides.length
        ? slides[idx]
        : el.querySelector('.splide__slide.is-active');
      if (!slide) return '';
      var style = (slide.getAttribute('data-mobile-header-style') || 'default').trim().toLowerCase();
      return (style === 'light' || style === 'dark') ? style : '';
    }

    function applyHeaderStyle(style) {
      if (style === 'light' || style === 'dark') {
        document.body.setAttribute('data-mobile-header-style', style);
      } else {
        document.body.removeAttribute('data-mobile-header-style');
      }
      updateAnnouncementBarColor(style);
      updateHeaderComponentColor(style);
    }

    /** Light = color-scheme-6, Dark = color-inverse. Default = restore theme default. */
    function updateHeaderComponentColor(style) {
      var header = document.getElementById('header-component');
      if (!header) return;
      var targetClass;
      if (style === 'dark') {
        targetClass = 'color-inverse';
      } else if (style === 'light') {
        targetClass = 'color-scheme-6';
      } else {
        var defaultScheme = header.getAttribute('data-default-color-scheme') || 'scheme-6';
        targetClass = defaultScheme.indexOf('color-') === 0 ? defaultScheme : 'color-' + defaultScheme;
      }
      var nodes = [header].concat(Array.prototype.slice.call(header.querySelectorAll('.header__row, .header__navigation-bar-row')));
      nodes.forEach(function (node) {
        var list = node.classList;
        for (var i = list.length - 1; i >= 0; i--) {
          if (list[i].indexOf('color-') === 0) list.remove(list[i]);
        }
        list.add(targetClass);
      });
    }

    /** Light = color-scheme-6, Dark = color-inverse. Default = theme default. */
    function updateAnnouncementBarColor(style) {
      var wrapper = document.querySelector('.header-announcements-wrapper');
      if (!wrapper) return;
      var defaultScheme = wrapper.getAttribute('data-announcement-default-color') || 'scheme-6';
      var targetClass;
      if (style === 'dark') {
        targetClass = 'color-inverse';
      } else if (style === 'light') {
        targetClass = 'color-scheme-6';
      } else {
        targetClass = defaultScheme.indexOf('color-') === 0 ? defaultScheme : 'color-' + defaultScheme;
      }
      [wrapper.querySelector('.section-background'), wrapper.querySelector('.announcement-bar')].forEach(function (node) {
        if (!node) return;
        var list = node.classList;
        for (var i = list.length - 1; i >= 0; i--) {
          if (list[i].indexOf('color-') === 0) list.remove(list[i]);
        }
        list.add(targetClass);
      });
    }

    function run() {
      var el = document.getElementById(splideId);
      if (!el || numSlides === 0 || typeof Splide === 'undefined') return;

      if (mounted) {
        mounted.destroy();
        mounted = null;
      }

      var opts = {
        type: '{{ section.settings.transition_type }}',
        autoplay: {{ section.settings.autoplay }},
        interval: {{ section.settings.autoplay_interval | times: 1000 }},
        arrows: {{ section.settings.show_arrows }},
        pagination: {{ section.settings.show_pagination }},
        pauseOnHover: {{ section.settings.pause_on_hover }},
        speed: {{ section.settings.transition_speed }},
        rewind: true,
        perPage: 1,
        perMove: 1
      };

      var splide = new Splide('#' + splideId, opts);
      splide.on('moved', function () {
        applyHeaderStyle(getActiveSlideStyle(el, splide));
      });
      splide.on('mounted', function () {
        applyHeaderStyle(getActiveSlideStyle(el, splide));
      });
      splide.mount();
      mounted = splide;
      lastMobile = isMobile();
    }

    function onResize() {
      var el = document.getElementById(splideId);
      var mobile = isMobile();
      if (el && mobile !== lastMobile) {
        run();
      } else if (el && mounted) {
        applyHeaderStyle(getActiveSlideStyle(el, mounted));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
    window.addEventListener('resize', onResize);
  })();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "ew-rhz-hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height (mobile)",
      "min": 200,
      "max": 2000,
      "step": 20,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slide_height_desktop",
      "label": "Slide height (desktop)",
      "min": 300,
      "max": 2000,
      "step": 20,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" },
        { "value": "loop", "label": "Loop" }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "default": 500,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)",
          "info": "Optional. Shown on screens under 750px. Uses desktop image if blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Mobile header & announcement"
        },
        {
          "type": "select",
          "id": "mobile_header_style",
          "label": "Header & announcement style (mobile only)",
          "info": "Override header and announcement bar colors on mobile when this slide is active.",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "light", "label": "Light (white background, black text)" },
            { "value": "dark", "label": "Dark (black background, white text)" }
          ],
          "default": "default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Hero Slider",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
