{% comment %}
  Hero Slider – Image + Link per slide, powered by Splide JS (loaded in theme.liquid)
{% endcomment %}

<section
  class="ew-rhz-hero-slider ew-rhz-hero-slider--{{ section.id }}"
  id="ew-rhz-hero-slider-{{ section.id }}"
  aria-label="Hero Slider"
>
  <style>
    #ew-rhz-hero-slider-{{ section.id }} .splide:not(.is-initialized) {
      visibility: visible;
    }

    #ew-rhz-hero-slider-{{ section.id }} .splide:not(.is-initialized) .splide__list {
      display: block;
    }

    #ew-rhz-hero-slider-{{ section.id }} .splide:not(.is-initialized) .splide__slide:not(:first-child) {
      display: none;
    }
  </style>

  <div class="ew-rhz-hero-slider__viewport">
    <div class="splide" id="ew-rhz-splide-hero-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
        {% for block in section.blocks %}
          <li
            class="splide__slide"
            data-hero-header-style="{{ block.settings.mobile_header_style | default: 'default' }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="ew-rhz-hero-slider__link">
            {% endif %}
            <div class="ew-rhz-hero-slider__slide-content">
              {% if block.settings.mobile_image != blank and block.settings.image != blank %}
                {% comment %}
                  Use <picture> so iOS Safari picks the correct asset reliably.
                  (Two <img> tags + CSS hide can still flash / stick on Safari under some caching/layout cases.)
                {% endcomment %}
                <picture class="ew-rhz-hero-slider__picture">
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                            {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                            {{ block.settings.mobile_image | image_url: width: 900 }} 900w"
                    sizes="100vw"
                  >
                  <source
                    media="(min-width: 750px)"
                    srcset="{{ block.settings.image | image_url: width: 960 }} 960w,
                            {{ block.settings.image | image_url: width: 1366 }} 1366w,
                            {{ block.settings.image | image_url: width: 1600 }} 1600w,
                            {{ block.settings.image | image_url: width: 1920 }} 1920w"
                    sizes="100vw"
                  >
                  <img
                    class="ew-rhz-hero-slider__image"
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.mobile_image.alt | default: block.settings.image.alt | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                    decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </picture>
              {% elsif block.settings.image != blank %}
                <img
                  class="ew-rhz-hero-slider__image"
                  src="{{ block.settings.image | image_url: width: 1600 }}"
                  srcset="{{ block.settings.image | image_url: width: 960 }} 960w,
                          {{ block.settings.image | image_url: width: 1366 }} 1366w,
                          {{ block.settings.image | image_url: width: 1600 }} 1600w,
                          {{ block.settings.image | image_url: width: 1920 }} 1920w"
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                  decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% elsif block.settings.mobile_image != blank %}
                <img
                  class="ew-rhz-hero-slider__image"
                  src="{{ block.settings.mobile_image | image_url: width: 750 }}"
                  srcset="{{ block.settings.mobile_image | image_url: width: 480 }} 480w,
                          {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                          {{ block.settings.mobile_image | image_url: width: 900 }} 900w"
                  sizes="100vw"
                  alt="{{ block.settings.mobile_image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                  decoding="{% if forloop.first %}sync{% else %}async{% endif %}"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ew-rhz-hero-slider__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var splideId = 'ew-rhz-splide-hero-{{ section.id }}';
    var numSlides = {{ section.blocks.size }};
    var mounted = null;
    var lastMobile = null;
    var splideWaitAttempts = 0;

    function isMobile() {
      return window.innerWidth <= 749;
    }

    /**
     * Get the active slide's header style: 'light' | 'dark' | ''
     * Uses splide.index when provided so we get the right slide even before .is-active is set.
     */
    function getActiveSlideStyle(el, splide) {
      if (!el) return '';
      var slides = el.querySelectorAll('.splide__slide');
      if (!slides.length) return '';
      var idx = splide && typeof splide.index === 'number' ? splide.index : -1;
      var slide = idx >= 0 && idx < slides.length
        ? slides[idx]
        : el.querySelector('.splide__slide.is-active');
      if (!slide) return '';
      var raw = slide.getAttribute('data-hero-header-style') || slide.getAttribute('data-mobile-header-style') || 'default';
      var style = raw.trim().toLowerCase();
      return (style === 'light' || style === 'dark') ? style : '';
    }

    /** When the header is pinned/sticky (data-sticky-state="active"), force dark for contrast over content. */
    function isHeaderStickyActive() {
      var header = document.getElementById('header-component');
      return !!(header && header.getAttribute('data-sticky-state') === 'active');
    }

    /**
     * Final style: slide choice on all viewports; sticky header always uses dark.
     */
    function getResolvedHeaderStyle(el, splide) {
      if (isHeaderStickyActive()) return 'dark';
      return getActiveSlideStyle(el, splide);
    }

    function applyHeaderStyle(style) {
      if (style === 'light' || style === 'dark') {
        document.body.setAttribute('data-mobile-header-style', style);
      } else {
        document.body.removeAttribute('data-mobile-header-style');
      }
      updateHeaderComponentColor(style);
    }

    /** Light = color-scheme-6, Dark = color-inverse. Default = restore theme default. */
    function updateHeaderComponentColor(style) {
      var header = document.getElementById('header-component');
      if (!header) return;
      var targetClass;
      if (style === 'dark') {
        targetClass = 'color-inverse';
      } else if (style === 'light') {
        targetClass = 'color-scheme-6';
      } else {
        var defaultScheme = header.getAttribute('data-default-color-scheme') || 'scheme-6';
        targetClass = defaultScheme.indexOf('color-') === 0 ? defaultScheme : 'color-' + defaultScheme;
      }
      var nodes = [header].concat(Array.prototype.slice.call(header.querySelectorAll('.header__row, .header__navigation-bar-row')));
      nodes.forEach(function (node) {
        var list = node.classList;
        for (var i = list.length - 1; i >= 0; i--) {
          if (list[i].indexOf('color-') === 0) list.remove(list[i]);
        }
        list.add(targetClass);
      });
    }

    function run() {
      var el = document.getElementById(splideId);
      if (!el || numSlides === 0) return;
      if (typeof Splide === 'undefined') {
        if (splideWaitAttempts > 100) return;
        splideWaitAttempts += 1;
        window.setTimeout(run, 50);
        return;
      }
      splideWaitAttempts = 0;

      if (mounted) {
        mounted.destroy();
        mounted = null;
      }

      var opts = {
        type: '{{ section.settings.transition_type }}',
        autoplay: {{ section.settings.autoplay }},
        interval: {{ section.settings.autoplay_interval | times: 1000 }},
        arrows: {{ section.settings.show_arrows }},
        pagination: {{ section.settings.show_pagination }},
        pauseOnHover: {{ section.settings.pause_on_hover }},
        speed: {{ section.settings.transition_speed }},
        rewind: true,
        perPage: 1,
        perMove: 1,
        autoHeight: true
      };

      var splide = new Splide('#' + splideId, opts);
      splide.on('moved', function () {
        applyHeaderStyle(getResolvedHeaderStyle(el, splide));
      });
      splide.on('mounted', function () {
        applyHeaderStyle(getResolvedHeaderStyle(el, splide));
      });
      splide.mount();
      mounted = splide;

      bindHeaderStickyObserver(el);

      el.querySelectorAll('img').forEach(function (img) {
        if (img.complete) return;
        img.addEventListener('load', function () {
          splide.refresh();
        });
      });
      lastMobile = isMobile();
    }

    function bindHeaderStickyObserver(heroSplideRoot) {
      var header = document.getElementById('header-component');
      if (!header || header.dataset.ewRhzHeroStickyBound === '1') return;
      header.dataset.ewRhzHeroStickyBound = '1';
      var obs = new MutationObserver(function () {
        if (!mounted) return;
        var root = document.getElementById(splideId);
        if (!root) return;
        applyHeaderStyle(getResolvedHeaderStyle(root, mounted));
      });
      obs.observe(header, { attributes: true, attributeFilter: ['data-sticky-state'] });
    }

    function onResize() {
      var el = document.getElementById(splideId);
      var mobile = isMobile();
      if (el && mobile !== lastMobile) {
        run();
      } else if (el && mounted) {
        applyHeaderStyle(getResolvedHeaderStyle(el, mounted));
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
    window.addEventListener('resize', onResize);
  })();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "ew-rhz-hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" },
        { "value": "loop", "label": "Loop" }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "default": 500,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Image (mobile)",
          "info": "Optional. Shown on screens under 750px. Uses desktop image if blank."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Header over hero"
        },
        {
          "type": "select",
          "id": "mobile_header_style",
          "label": "Header style",
          "info": "Adjusts header colors (logo, menu, icons) for this slide on all screen sizes. When the header is sticky/pinned (data-sticky-state active), it always uses the Dark treatment for contrast.",
          "options": [
            { "value": "default", "label": "Default (theme)" },
            { "value": "light", "label": "Light (white background, dark text)" },
            { "value": "dark", "label": "Dark (dark background, light text)" }
          ],
          "default": "default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Hero Slider",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
