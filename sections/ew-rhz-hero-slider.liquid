{% comment %}
  Hero Slider – Image + Link per slide, powered by Splide JS (loaded in theme.liquid)
{% endcomment %}

<section
  class="ew-rhz-hero-slider ew-rhz-hero-slider--{{ section.id }}"
  id="ew-rhz-hero-slider-{{ section.id }}"
  aria-label="Hero Slider"
  style="--ew-rhz-slide-height: {{ section.settings.slide_height }}px; --ew-rhz-slide-height-desktop: {{ section.settings.slide_height_desktop }}px;"
>
  <div class="ew-rhz-hero-slider__viewport">
    <div class="splide" id="ew-rhz-splide-hero-{{ section.id }}">
      <div class="splide__track">
        <ul class="splide__list">
        {% for block in section.blocks %}
          <li class="splide__slide" data-mobile-header-style="{{ block.settings.mobile_header_style | default: 'default' }}" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="ew-rhz-hero-slider__link">
            {% endif %}
            <div class="ew-rhz-hero-slider__slide-content">
              {% if block.settings.image != blank %}
                <img
                  class="ew-rhz-hero-slider__image"
                  src="{{ block.settings.image | image_url: width: 1920 }}"
                  srcset="{{ block.settings.image | image_url: width: 640 }} 640w,
                          {{ block.settings.image | image_url: width: 1024 }} 1024w,
                          {{ block.settings.image | image_url: width: 1920 }} 1920w"
                  sizes="100vw"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ew-rhz-hero-slider__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </li>
        {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var splideId = 'ew-rhz-splide-hero-{{ section.id }}';
    var numSlides = {{ section.blocks.size }};
    var mounted = null;
    var lastMobile = null;

    function isMobile() {
      return window.innerWidth <= 749;
    }

    function setMobileHeaderStyle(el) {
      if (!el) return;
      if (window.innerWidth > 749) {
        document.body.removeAttribute('data-mobile-header-style');
        return;
      }
      var slide = el.querySelector('.splide__slide.is-active');
      var style = slide ? (slide.getAttribute('data-mobile-header-style') || 'default') : '';
      if (style && style !== 'default') {
        document.body.setAttribute('data-mobile-header-style', style);
      } else {
        document.body.removeAttribute('data-mobile-header-style');
      }
    }

    function run() {
      var el = document.getElementById(splideId);
      if (!el || numSlides === 0 || typeof Splide === 'undefined') return;

      if (mounted) {
        mounted.destroy();
        mounted = null;
      }

      var mobile = isMobile();
      var opts = {
        type: '{{ section.settings.transition_type }}',
        autoplay: {{ section.settings.autoplay }},
        interval: {{ section.settings.autoplay_interval | times: 1000 }},
        arrows: {{ section.settings.show_arrows }},
        pagination: {{ section.settings.show_pagination }},
        pauseOnHover: {{ section.settings.pause_on_hover }},
        speed: {{ section.settings.transition_speed }},
        rewind: true,
        perPage: 1,
        perMove: 1
      };
      if (mobile) {
        opts.direction = 'ttb';
        opts.height = '100vh';
        opts.drag = true;
      }

      var splide = new Splide('#' + splideId, opts);
      splide.on('moved', function () {
        setMobileHeaderStyle(el);
      });
      splide.mount();
      mounted = splide;
      lastMobile = mobile;
      setMobileHeaderStyle(el);
    }

    function onResize() {
      var el = document.getElementById(splideId);
      var mobile = isMobile();
      if (el && mobile !== lastMobile) {
        run();
      } else if (el) {
        setMobileHeaderStyle(el);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
    window.addEventListener('resize', onResize);
  })();
</script>

{% schema %}
{
  "name": "Hero Slider",
  "tag": "section",
  "class": "ew-rhz-hero-slider-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height (mobile)",
      "min": 200,
      "max": 800,
      "step": 20,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "slide_height_desktop",
      "label": "Slide height (desktop)",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "select",
      "id": "transition_type",
      "label": "Transition",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" },
        { "value": "loop", "label": "Loop" }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 200,
      "max": 1200,
      "step": 100,
      "default": 500,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Autoplay interval",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
        {
          "type": "header",
          "content": "Mobile header & announcement"
        },
        {
          "type": "select",
          "id": "mobile_header_style",
          "label": "Header & announcement style (mobile only)",
          "info": "Override header and announcement bar colors on mobile when this slide is active.",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "light", "label": "Light (white background, black text)" },
            { "value": "dark", "label": "Dark (black background, white text)" }
          ],
          "default": "default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Hero Slider",
      "category": "Banners",
      "blocks": [
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        },
        {
          "type": "slide",
          "settings": {
            "link": "shopify://collections/all"
          }
        }
      ]
    }
  ]
}
{% endschema %}
