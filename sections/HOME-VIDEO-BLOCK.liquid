<div class="container-fluid section-my">

<h2 class="headinds">{{ section.settings.heading }}</h2>
  
  <div class="{{ section.settings.addclassnew }}">
      {% for block in section.blocks %}
      <div class="items">
        <a href="{{ block.settings.link }}">
          <picture class="hero-item__mask">
            <source media="(min-width: 768px)" srcset="{{ block.settings.img | img_url: 'master' }}" />
            <source media="(max-width: 767px)" srcset="{{ block.settings.img_mobile | img_url: 'master' }}" />
            <img class="lazyload lazypreload" src="{{ block.settings.img | img_url: 'master' }}" alt=""/>
          </picture>
          <h2>{{ block.settings.title }}</h2>
        </a>
      </div>

      {% endfor %}
  </div>
    
</div>

{% schema %}
  {
    "name": "HOME-VIDEO-BLOCK",
    "settings": [
		{
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "default": "Title"
    	},
        {
        "type": "select",
        "id": "addclassnew",
        "label": "Add Slider Classes",
        "options": [
        {
        "value": "singlebox",
        "label": "singlebox"
        },
        {
        "value": "towboxs",
        "label": "towboxs"
        },
        {
        "value": "threeboxss",
        "label": "threeboxss"
        },
		{
        "value": "singlebox withtxt",
        "label": "singlebox withtxt"
        },
        {
        "value": "towboxs withtxt",
        "label": "towboxs withtxt"
        },
        {
        "value": "threeboxss withtxt",
        "label": "threeboxss withtxt"
        }
        ],
        "default": "singlebox"
        }
	],
	"blocks":[
		{
			"type": "select",
			"name": "Photo",
			"settings": [
			  {
                "id": "link",
                "type": "url",
                 "label": "URL"
              },
              {
                "id": "img",
                "type": "image_picker",
                "label": "Image"
                
              },
			  {
                "id": "img_mobile",
                "type": "image_picker",
                 "label": "Mobile Image"
              },
			  {
                "id": "title",
                "type": "textarea",
                 "label": "TITLE"
              }
            ]
		}
	],
  "presets": [
    {
      "name": {
        "en": "HOME-VIDEO-BLOCK"
      }
    }
  ]
  }
{% endschema %}