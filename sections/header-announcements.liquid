{% liquid
  assign announcement_transparent = false
  assign announcement_transparent_scheme = ''

  assign inverse_scheme = section.settings.color_scheme_transparent | default: 'scheme-6'

  if section.settings.enable_transparent_announcement_home and template.name == 'index'
    assign announcement_transparent = true
    if section.settings.home_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_home
    endif
  elsif section.settings.enable_transparent_announcement_product and template.name == 'product'
    assign announcement_transparent = true
    if section.settings.product_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  elsif section.settings.enable_transparent_announcement_collection and template.name == 'collection'
    assign announcement_transparent = true
    if section.settings.collection_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  endif

  if announcement_transparent == false
    if template.name == 'index'
      assign announcement_transparent_scheme = section.settings.color_scheme_home
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  endif
%}

<div
  class="header-announcements-wrapper{% if announcement_transparent %} header-announcements--transparent{% endif %}"
  {% if announcement_transparent %}
    data-transparent="true"
  {% endif %}
  data-announcement-default-color="{{ announcement_transparent_scheme }}"
>
  <div class="section-background color-{{ announcement_transparent_scheme }}"></div>
  <aside
    class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ announcement_transparent_scheme }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px; --announcement-marquee-duration: {{ 24 | divided_by: section.settings.speed }}s;"
  >
    {%- assign announcement_text = section.settings.announcement_text | strip -%}
    <div
      class="announcement-bar__ticker"
      aria-label="{{ announcement_text | strip_html | escape }}"
      role="marquee"
    >
      <div class="announcement-bar__track" id="announcement-track-{{ section.id }}">
        <span class="announcement-bar__item">
          {%- if announcement_text != blank -%}
            {%- if section.settings.announcement_link != blank -%}
              <a class="announcement-bar__link-inline" href="{{ section.settings.announcement_link }}">{{ announcement_text }}</a>
            {%- else -%}
              <span class="announcement-bar__text-inline">{{ announcement_text }}</span>
            {%- endif -%}
          {%- else -%}
            <span class="announcement-bar__text-inline">&nbsp;</span>
          {%- endif -%}
          <span class="announcement-bar__sep" aria-hidden="true">&nbsp;&nbsp;✦&nbsp;&nbsp;</span>
        </span>
      </div>
    </div>

    <script>
      (function () {
        var track = document.getElementById('announcement-track-{{ section.id }}');
        if (!track) return;

        function init() {
          var original = track.querySelector('.announcement-bar__item');
          if (!original) return;

          var itemWidth = original.getBoundingClientRect().width;
          if (itemWidth === 0) return;

          // Fill at least 3× the viewport width so there are no gaps
          var copies = Math.ceil((window.innerWidth * 3) / itemWidth);
          for (var i = 1; i < copies; i++) {
            track.appendChild(original.cloneNode(true));
          }

          // Duplicate the full set — animation goes from 0 to -50% for seamless loop
          track.innerHTML = track.innerHTML + track.innerHTML;

          // Calculate duration based on content length & speed setting
          var halfWidth = track.scrollWidth / 2;
          var speed = {{ section.settings.speed | default: 5 }};
          var pxPerSecond = speed * 20; // speed 2–10 → 40–200 px/s
          var duration = (halfWidth / pxPerSecond).toFixed(2);

          track.style.setProperty('--marquee-duration', duration + 's');
          track.classList.add('announcement-bar__track--running');
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
  </aside>
</div>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    min-height: 2.5rem;
    position: relative;
    z-index: var(--layer-base, 0);
  }

  /* Ticker container */
  .announcement-bar__ticker {
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    width: 100%;
    position: relative;
    z-index: 1;
  }

  /* Scrolling track */
  .announcement-bar__track {
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
  }

  @keyframes announcement-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .announcement-bar__track--running {
    animation: announcement-scroll var(--marquee-duration, 20s) linear infinite;
  }

  /* Pause on hover/focus for accessibility */
  .announcement-bar__ticker:hover .announcement-bar__track--running,
  .announcement-bar__ticker:focus-within .announcement-bar__track--running {
    animation-play-state: paused;
  }

  /* Each repeated item */
  .announcement-bar__item {
    display: inline-flex;
    align-items: center;
    padding-inline: 0.5rem;
    color: var(--color-foreground, #1a1a1a);
    font-size: 0.875rem;
  }

  .announcement-bar__text-inline,
  .announcement-bar__link-inline {
    color: inherit;
    font: inherit;
  }

  .announcement-bar__link-inline {
    text-decoration: none;
  }

  .announcement-bar__sep {
    user-select: none;
    pointer-events: none;
    opacity: 0.6;
  }

  /* Transparent announcement bar */
  .header-announcements--transparent .section-background {
    background-color: transparent;
  }

  .header-announcements--transparent .announcement-bar {
    background-color: rgb(0 0 0 / 0.45);
    border-block-end-color: transparent;
  }

  .header-announcements--transparent .announcement-bar__item {
    color: #fff;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Welcome to our store!"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link (optional)"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "Transparent announcement bar"
    },
    {
      "type": "paragraph",
      "content": "Show a transparent background on specific pages. Use 'Inverse' for light text over dark hero images."
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_home",
      "label": "Enable on home page",
      "default": false
    },
    {
      "type": "select",
      "id": "home_announcement_color_scheme",
      "label": "Home page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_home }}"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_product",
      "label": "Enable on product page",
      "default": false
    },
    {
      "type": "select",
      "id": "product_announcement_color_scheme",
      "label": "Product page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_product }}"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_collection",
      "label": "Enable on collection page",
      "default": false
    },
    {
      "type": "select",
      "id": "collection_announcement_color_scheme",
      "label": "Collection page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_collection }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_transparent",
      "label": "Color scheme (inverse)",
      "info": "Used when 'Inverse' is selected for transparent pages",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_home",
      "default": "scheme-4",
      "label": "Color scheme (home page)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_other_pages",
      "default": "scheme-4",
      "label": "Color scheme (other pages)"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "settings": {
        "announcement_text": "Welcome to our store!"
      }
    }
  ]
}
{% endschema %}
