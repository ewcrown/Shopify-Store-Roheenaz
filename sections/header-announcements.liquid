{% liquid
  assign announcement_transparent = false
  assign announcement_transparent_scheme = ''

  assign inverse_scheme = section.settings.color_scheme_transparent | default: 'scheme-6'

  if section.settings.enable_transparent_announcement_home and template.name == 'index'
    assign announcement_transparent = true
    if section.settings.home_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_home
    endif
  elsif section.settings.enable_transparent_announcement_product and template.name == 'product'
    assign announcement_transparent = true
    if section.settings.product_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  elsif section.settings.enable_transparent_announcement_collection and template.name == 'collection'
    assign announcement_transparent = true
    if section.settings.collection_announcement_color_scheme == 'inverse'
      assign announcement_transparent_scheme = inverse_scheme
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  endif

  if announcement_transparent == false
    if template.name == 'index'
      assign announcement_transparent_scheme = section.settings.color_scheme_home
    else
      assign announcement_transparent_scheme = section.settings.color_scheme_other_pages
    endif
  endif
%}

{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

<div
  class="header-announcements-wrapper{% if announcement_transparent %} header-announcements--transparent{% endif %}"
  {% if announcement_transparent %}data-transparent="true"{% endif %}
  data-announcement-default-color="{{ announcement_transparent_scheme }}"
>
  <div class="section-background color-{{ announcement_transparent_scheme }}"></div>
  <aside
    class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ announcement_transparent_scheme }}"
    style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
  >
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {% content_for 'blocks' %}
    </div>
  </announcement-bar-component>
  </aside>
</div>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  /* Transparent announcement bar */
  .header-announcements--transparent .section-background {
    background-color: transparent;
  }

  .header-announcements--transparent .announcement-bar {
    background-color: transparent;
    border-block-end-color: transparent;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "Transparent announcement bar"
    },
    {
      "type": "paragraph",
      "content": "Show a transparent background on specific pages. Use 'Inverse' for light text over dark hero images."
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_home",
      "label": "Enable on home page",
      "default": false
    },
    {
      "type": "select",
      "id": "home_announcement_color_scheme",
      "label": "Home page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_home }}"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_product",
      "label": "Enable on product page",
      "default": false
    },
    {
      "type": "select",
      "id": "product_announcement_color_scheme",
      "label": "Product page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_product }}"
    },
    {
      "type": "checkbox",
      "id": "enable_transparent_announcement_collection",
      "label": "Enable on collection page",
      "default": false
    },
    {
      "type": "select",
      "id": "collection_announcement_color_scheme",
      "label": "Collection page color scheme",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "inverse", "label": "Inverse (light text)" }
      ],
      "default": "inverse",
      "visible_if": "{{ section.settings.enable_transparent_announcement_collection }}"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_transparent",
      "label": "Color scheme (inverse)",
      "info": "Used when 'Inverse' is selected for transparent pages",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_home",
      "default": "scheme-4",
      "label": "Color scheme (home page)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_other_pages",
      "default": "scheme-4",
      "label": "Color scheme (other pages)"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
