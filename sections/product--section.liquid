<style>
/* Global Reset */
.product__page--main-container {
  display: grid;
  grid-template-columns: 1fr 400px;
  gap: 40px;
  padding: 20px;
  max-width: 1400px;
  margin: 0 auto;
}

/* Media column – native gallery lives here */
.product__page--media {
  position: sticky;
  top: 20px;
  height: fit-content;
}

.mobile__product__page--container { display: none; }

/* RIGHT INFO SECTION */
.product__page--product__information--section {
  position: sticky;
  top: 20px;
  height: fit-content;
}

.product__page--product__information--section h1 {
  font-size: 24px;
  margin-bottom: 5px;
  text-transform: uppercase;
}

.sku { font-size: 11px; color: #999; letter-spacing: 1px; }

.price {
  font-size: 20px;
  font-weight: 600;
  margin: 15px 0;
}

/* PILLS STYLE */
.pill-container { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 20px; }
.pill {
  padding: 8px 18px;
  border: 1px solid #e0e0e0;
  border-radius: 50px;
  font-size: 12px;
  cursor: pointer;
  text-transform: uppercase;
}
.pill.active { background: #000; color: #fff; border-color: #000; }

/* QUANTITY & BUTTON */
.purchase-row { display: flex; gap: 12px; margin-top: 20px; }
.qty-box {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50px;
  padding: 5px 15px;
  justify-content: space-between;
  width: 120px;
}
.qty-box button { border: none; background: none; cursor: pointer; font-size: 18px; padding: 5px; }

.btn-add {
  flex: 1;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 50px;
  padding: 16px;
  font-weight: bold;
  cursor: pointer;
}

{% comment %} /* Reset & Global */
.product__page--main-container, .mobile__product__page--container {
  font-family: 'Inter', sans-serif; /* Ya jo bhi apka theme font ho */
  color: #333;
}

/* DESKTOP LAYOUT */
.product__page--main-container {
  display: grid;
  grid-template-columns: 60% 40%;
  gap: 50px;
}
.product__page--media {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}
.product__page--gallery--thumbnails {
  display: flex; flex-direction: column; gap: 10px; position: sticky; top: 20px; height: fit-content;
}
.product__page--gallery--thumbnails img { width: 100%; cursor: pointer; border: 1px solid #eee; }

.product__page--gallery--main-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.product__page--gallery--main-grid img { width: 100%; display: block; }

/* RIGHT INFO SECTION */
.product__page--product__information--section { position: sticky; top: 20px; height: fit-content; }
.product__page--product__information--section h1 { font-size: 22px; font-weight: 400; margin-bottom: 2px; }
.sku { font-size: 10px; color: #aaa; text-transform: uppercase; letter-spacing: 1px; }
.rating { font-size: 12px; margin: 10px 0; color: #444; }
.price { font-size: 18px; font-weight: 500; margin-bottom: 20px; }

.section-label { font-size: 12px; font-weight: 500; margin-top: 15px; display: block; }
.variant-label-value { font-weight: 600; color: #333; }
.description-content { font-size: 12px; line-height: 1.6; color: #777; margin-bottom: 20px; }
.description-content li { list-style: none; margin-bottom: 2px; }
.description-content li::before { content: "• "; }

/* PILLS STYLE (Size/Fabric) */
.pill-container { display: flex; gap: 10px; margin: 8px 0 20px; }
.pill {
  padding: 6px 20px; border: 1px solid #ddd; border-radius: 20px;
  font-size: 12px; cursor: pointer; transition: 0.2s; min-width: 60px; text-align: center;
}
.pill.active { background: #000; color: #fff; border-color: #000; }

.color-circle {
  width: 25px; height: 25px; border-radius: 50%; background: #5e5e4e; 
  border: 1px solid #ccc; margin-top: 8px; cursor: pointer;
}

/* LINING OPTION (Grey Capsule) */
.lining-option {
  background: #f1f1f1; display: inline-flex; align-items: center;
  padding: 8px 15px; border-radius: 12px; margin: 15px 0; cursor: pointer;
}
.checkbox-container { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #333; }
.checkmark { width: 18px; height: 18px; background: #fff; border: 1px solid #ccc; border-radius: 4px; display: inline-block; position: relative; }
input:checked ~ .checkmark { background: #000; border-color: #000; }
input:checked ~ .checkmark::after { content: "✓"; color: #fff; font-size: 12px; position: absolute; left: 3px; top: -1px; }

/* PURCHASE ROW */
.purchase-row { display: flex; gap: 10px; margin-top: 25px; }
.qty-box {
  display: flex; align-items: center; background: #000; color: #fff;
  border-radius: 30px; padding: 10px 20px; min-width: 110px; justify-content: space-between;
}
.qty-box button { background: none; border: none; color: #fff; font-size: 18px; cursor: pointer; }

.btn-add {
  flex-grow: 1; background: #000; color: #fff; border: none;
  border-radius: 30px; padding: 15px; font-weight: 600; font-size: 13px;
  cursor: pointer; text-transform: uppercase; letter-spacing: 1px;
} {% endcomment %}

.notice { font-size: 13px; font-weight: 500; margin: 25px 0 5px; }
.sub-notice { font-size: 11px; color: #999; line-height: 1.5; margin-bottom: 25px; display: block; }

/* ACCORDION */
.acc-item { border-top: 1px solid #eee; border-bottom: 1px solid #eee; margin-bottom: -1px; }
.acc-btn {
  width: 100%; padding: 15px 0; background: none; border: none;
  display: flex; justify-content: space-between; font-size: 13px; font-weight: 500; cursor: pointer;
}
.acc-content { max-height: 0; overflow: hidden; transition: 0.3s ease; font-size: 12px; color: #777; line-height: 1.6; }

/* MOBILE LAYOUT */
@media (max-width: 1024px) {
  .product__page--main-container { display: none; }
  .mobile__product__page--container { display: flex; flex-direction: column; }
  .product__page--media { padding: 0 0 10px; }
  .mobile__product__page--product__information--section { padding: 15px; }
  .mobile__info-header { display: flex; justify-content: space-between; align-items: center; }
  .mobile__info-header h1 { font-size: 20px; }
  .mobile__share-icon { font-size: 20px; }
  .mobile__pills { display: flex; gap: 8px; margin-top: 10px; }
  .mobile__pill { padding: 6px 15px; border: 1px solid #ddd; border-radius: 20px; font-size: 12px; }
  .mobile__pill.active { background: #000; color: #fff; }
  .mobile__lining-wrapper { background: #f1f1f1; padding: 10px 15px; border-radius: 12px; display: flex; align-items: center; gap: 10px; margin: 20px 0; font-size: 13px; }
  .mobile__custom-check { width: 18px; height: 18px; background: #fff; border: 1px solid #ccc; border-radius: 4px; }
  .mobile__lining-wrapper.active .mobile__custom-check { background: #000; border-color: #000; position: relative; }
  .mobile__lining-wrapper.active .mobile__custom-check::after { content: "✓"; color: #fff; font-size: 12px; position: absolute; left: 3px; top: -1px; }
  .mobile__qty-selector { background: #000; color: #fff; border-radius: 30px; display: flex; align-items: center; justify-content: space-between; padding: 10px 15px; min-width: 100px; }
  .mobile__btn-add { flex: 1; background: #000; color: #fff; border: none; border-radius: 30px; font-weight: 600; text-transform: uppercase; font-size: 13px; }
}
</style>

<div class="section section--full-width-margin section--page-width">
<div class="product__page--main-container">
<div class="product__page--media">
  {%- for block in section.blocks -%}
    {%- if block.type == '_product-media-gallery' -%}
      {% render 'product-media-gallery-content',
        product: product,
        media_presentation: block.settings.media_presentation,
        block_settings: block.settings,
        block_id: block.id,
        block_shopify_attributes: block.shopify_attributes
      %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
</div>

<div class="product__page--product__information--section">
  <h1>{{ product.title }}</h1>
  <span class="sku">SKU: {{ product.selected_or_first_available_variant.sku }}</span>
  <div class="rating">★★★★☆ <span style="color:#999; margin-left:10px">2 REVIEWS</span></div>
  <div class="price" id="price-desktop">{{ product.selected_or_first_available_variant.price | money }}</div>

  <span class="section-label">Shirt:</span>
  <div class="description-content">
    {{ product.description }}
  </div>

  {%- for option in product.options_with_values -%}
    <span class="section-label">{{ option.name }}: <span id="label-{{ option.name | handle }}" class="variant-label-value">{{ option.selected_value }}</span></span>
    <div class="pill-container js-variant-container" id="opt-{{ option.name | handle }}" data-option-name="{{ option.name | handle }}">
      {%- for value in option.values -%}
        <div class="pill {% if option.selected_value == value %}active{% endif %}" data-value="{{ value | escape }}">
          {{ value }}
        </div>
      {%- endfor -%}
    </div>
  {%- endfor -%}

  <span class="section-label">Color: <span style="font-weight: normal; color: #888;">Lime yellow</span></span>
  <div class="color-circle"></div>

  {% form 'product', product %}
    <input type="hidden" name="id" id="variant-id-desktop" value="{{ product.selected_or_first_available_variant.id }}">
    
    <div class="lining-option js-lining-toggle">
      <label class="checkbox-container">
        <span class="checkmark"></span>
        <input type="checkbox" name="properties[Sleeve Lining]" value="Yes" style="display:none">
        Add Sleeve Lining
      </label>
    </div>

    <div class="purchase-row">
      <div class="qty-box">
        <button type="button" class="js-qty" data-delta="-1">-</button>
        <span id="qty-desktop">1</span>
        <button type="button" class="js-qty" data-delta="1">+</button>
        <input type="hidden" name="quantity" id="qty-input-desktop" value="1">
      </div>
      <button type="submit" class="btn-add">ADD TO CART</button>
    </div>
  {% endform %}

  <p class="notice">All stitched articles required advance payment</p>
  <span class="sub-notice">All Unstitched orders will be dispatched within 3 working days.<br>All Stitched orders will be dispatched within 14-18 working days.</span>

  <div class="acc-item">
    <button class="acc-btn js-acc">Care Instructions <span>⌄</span></button>
    <div class="acc-content"><p>{{ product.metafields.custom.care_instructions }}</p></div>
  </div>
  <div class="acc-item">
    <button class="acc-btn js-acc">Disclaimers <span>⌄</span></button>
    <div class="acc-content"><p>Product color may vary slightly due to lighting.</p></div>
  </div>
</div>
</div>
</div>

<div class="mobile__product__page--container">
<div class="section section--full-width-margin section--page-width">
<div class="product__page--media mobile-only-gallery">
  {%- for block in section.blocks -%}
    {%- if block.type == '_product-media-gallery' -%}
      {% render 'product-media-gallery-content',
        product: product,
        media_presentation: block.settings.media_presentation,
        block_settings: block.settings,
        block_id: block.id,
        block_shopify_attributes: block.shopify_attributes
      %}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
</div>
<div class="mobile__product__page--product__information--section">
  <div class="mobile__info-header">
    <h1>{{ product.title }}</h1>
    <span class="mobile__share-icon">⎋</span>
  </div>
  <span class="mobile__sku">SKU: {{ product.selected_or_first_available_variant.sku }}</span>
  <div class="mobile__rating">★★★★☆ <span style="color:#888; margin-left:8px;">2 REVIEWS</span></div>
  <div class="mobile__price" id="price-mobile">{{ product.selected_or_first_available_variant.price | money }}</div>

  {%- for option in product.options_with_values -%}
    <div class="mobile__option-group">
      <span class="section-label">{{ option.name }}: <span id="m-label-{{ option.name | handle }}" class="variant-label-value">{{ option.selected_value }}</span></span>
      <div class="mobile__pills js-variant-container" data-option-name="{{ option.name | handle }}">
        {%- for value in option.values -%}
          <div class="mobile__pill {% if option.selected_value == value %}active{% endif %}" data-value="{{ value | escape }}">{{ value }}</div>
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

  {% form 'product', product %}
    <input type="hidden" name="id" id="variant-id-mobile" value="{{ product.selected_or_first_available_variant.id }}">
    <div class="mobile__lining-wrapper js-lining-toggle">
        <div class="mobile__custom-check"></div>
        <input type="checkbox" name="properties[Sleeve Lining]" value="Yes" style="display:none">
        <span>Add Sleeve Lining</span>
    </div>
    <div class="mobile__purchase-row">
        <div class="mobile__qty-selector">
            <button type="button" class="js-qty" data-delta="-1">-</button>
            <span id="qty-mobile">1</span>
            <button type="button" class="js-qty" data-delta="1">+</button>
            <input type="hidden" name="quantity" id="qty-input-mobile" value="1">
        </div>
        <button type="submit" class="mobile__btn-add">Add to Cart</button>
    </div>
  {% endform %}
  
  <div class="mobile__accordion">
    <div class="mobile__acc-item">
      <button type="button" class="acc-btn js-acc">Care Instructions <span>⌄</span></button>
      <div class="acc-content"><p>{{ product.metafields.custom.care_instructions }}</p></div>
    </div>
  </div>
</div>
</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
const variants = [
  {%- for v in product.variants -%}
  {"id":{{ v.id }},"price":{{ v.price }},"option1":{{ v.option1 | json }},"option2":{{ v.option2 | default: '' | json }},"option3":{{ v.option3 | default: '' | json }},"price_formatted":{{ v.price | money | strip_html | json }}}
  {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
];
const optionsOrderHandles = [
  {%- for opt in product.options_with_values -%}
  "{{ opt.name | handle }}"
  {%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
];

// Variant Switching
document.querySelectorAll('.js-variant-container').forEach(container => {
  container.addEventListener('click', (e) => {
    if (!e.target.classList.contains('pill') && !e.target.classList.contains('mobile__pill')) return;
    var optName = container.dataset.optionName;
    var val = e.target.dataset.value;
    document.querySelectorAll('.js-variant-container[data-option-name="' + optName + '"]').forEach(function (c) {
      Array.from(c.children).forEach(function (p) {
        p.classList.toggle('active', p.dataset.value === val);
      });
    });
    updateSelectedVariant();
  });
});

function updateSelectedVariant() {
  var selected = {};
  document.querySelectorAll('.js-variant-container').forEach(function (container) {
    var optName = container.dataset.optionName;
    var active = container.querySelector('.pill.active, .mobile__pill.active');
    if (optName && active) {
      selected[optName] = active.dataset.value;
      var labelDesk = document.getElementById('label-' + optName);
      var labelMob = document.getElementById('m-label-' + optName);
      if (labelDesk) labelDesk.textContent = active.dataset.value;
      if (labelMob) labelMob.textContent = active.dataset.value;
    }
  });
  var opt1 = selected[optionsOrderHandles[0]];
  var opt2 = selected[optionsOrderHandles[1]];
  var opt3 = selected[optionsOrderHandles[2]];
  var match = variants.find(function (v) {
    return v.option1 === opt1 && (!opt2 || v.option2 === opt2) && (!opt3 || v.option3 === opt3);
  });
  if (match) {
    document.getElementById('variant-id-desktop').value = match.id;
    document.getElementById('variant-id-mobile').value = match.id;
    var priceStr = match.price_formatted || '';
    var priceDesk = document.getElementById('price-desktop');
    var priceMob = document.getElementById('price-mobile');
    if (priceDesk) priceDesk.textContent = priceStr;
    if (priceMob) priceMob.textContent = priceStr;
  }
}

// Quantity
document.querySelectorAll('.js-qty').forEach(btn => {
  btn.addEventListener('click', () => {
    const delta = parseInt(btn.dataset.delta);
    const isMobile = btn.closest('.mobile__product__page--container');
    const display = document.getElementById(isMobile ? 'qty-mobile' : 'qty-desktop');
    const input = document.getElementById(isMobile ? 'qty-input-mobile' : 'qty-input-desktop');
    let val = parseInt(display.innerText) + delta;
    if (val < 1) val = 1;
    display.innerText = val;
    input.value = val;
  });
});

// Accordion
document.querySelectorAll('.js-acc').forEach(btn => {
  btn.addEventListener('click', () => {
    const content = btn.nextElementSibling;
    const icon = btn.querySelector('span');
    if (content.style.maxHeight) {
      content.style.maxHeight = null;
      icon.innerText = '⌄';
    } else {
      content.style.maxHeight = content.scrollHeight + "px";
      icon.innerText = '⌃';
    }
  });
});

// Lining Toggle
document.querySelectorAll('.js-lining-toggle').forEach(el => {
  el.addEventListener('click', () => {
    el.classList.toggle('active');
    const chk = el.querySelector('input[type="checkbox"]');
    chk.checked = !chk.checked;
  });
});
});
</script>

{% schema %}
{
"name": "product Information",
"settings": [],
"presets": [
  {
    "name": "Product Information Pro"
  }
]

}
{% endschema %}