<div class="container">

<h2 class="headind">{{ section.settings.heading }}</h2>
  
  <div class="{{ section.settings.addclassnew }}">
      {% for block in section.blocks %}
      <div class="item">
        <a href="{{ block.settings.link }}">
          <picture class="hero-item__mask">
            <source media="(min-width: 768px)" srcset="{{ block.settings.img | img_url: 'master' }}" />
            <source media="(max-width: 767px)" srcset="{{ block.settings.img_mobile | img_url: 'master' }}" />
            <img class="lazyload lazypreload" src="{{ block.settings.img | img_url: 'master' }}" alt=""/>
            <div class="withtxt-header">
              <h2>{{ block.settings.title }}</h2>
              <span>{{ block.settings.btntxt }}</span>
            </div>
          </picture>
        </a>
      </div>
      {% endfor %}
  </div>
</div>

{% schema %}
  {
    "name": "HOME STATIC BLOCKS",
    "settings": [
		{
          "id": "heading",
          "type": "text",
          "label": "Heading",
          "default": "Title"
    	},
        {
        "type": "select",
        "id": "addclassnew",
        "label": "Add Slider Classes",
        "options": [
        {
        "value": "singlebox",
        "label": "singlebox"
        },
        {
        "value": "towboxs",
        "label": "towboxs"
        },
        {
        "value": "threeboxs",
        "label": "threeboxs"
        },
		{
        "value": "singlebox withtxt",
        "label": "singlebox withtxt"
        },
        {
        "value": "towboxs withtxt",
        "label": "towboxs withtxt"
        },
        {
        "value": "threeboxs withtxt",
        "label": "threeboxs withtxt"
        }
        ],
        "default": "singlebox"
        }
	],
	"blocks":[
		{
			"type": "select",
			"name": "Photo",
			"settings": [
			  {
                "id": "link",
                "type": "url",
                 "label": "URL"
              },
              {
                "id": "img",
                "type": "image_picker",
                "label": "Image"
                
              },
			  {
                "id": "img_mobile",
                "type": "image_picker",
                 "label": "Mobile Image"
              },
			  {
                "id": "title",
                "type": "text",
                 "label": "TITLE"
              },
			  {
                "id": "btntxt",
                "type": "text",
                 "label": "BTN INFO"
              }
            ]
		}
	],
  "presets": [
    {
      "name": {
        "en": "HOME STATIC BLOCKS"
      }
    }
  ]
  }
{% endschema %}