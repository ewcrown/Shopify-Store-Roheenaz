{% comment %}
  Curated Cards – Title, subtitle, and image cards with text overlay.
  Section: title/subtitle with typography preset, alignment, spacing (mobile/desktop)
  Block: image, link, text overlay (editable, alignment, colors), height (mobile/desktop)
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<section
  class="ew-rhz-curated-cards section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style gap-style"
  id="ew-rhz-curated-cards-{{ section.id }}"
  {% assign curated_card_count = section.blocks | where: 'type', 'card' | size %}
  {% if curated_card_count > 5 %}{% assign curated_desktop_columns = 5 %}{% else %}{% assign curated_desktop_columns = curated_card_count %}{% endif %}
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.cards_gap %}
    --ew-rhz-header-gap-mobile: {{ section.settings.header_gap_mobile }}px;
    --ew-rhz-header-gap-desktop: {{ section.settings.header_gap_desktop }}px;
    --ew-rhz-header-spacing-mobile: {{ section.settings.header_spacing_mobile }}px;
    --ew-rhz-header-spacing-desktop: {{ section.settings.header_spacing_desktop }}px;
    --ew-rhz-card-count: {{ curated_card_count }};
    --ew-rhz-desktop-columns: {{ curated_desktop_columns }};
    --ew-rhz-card-height-mobile: {{ section.settings.block_height_mobile }}px;
    --ew-rhz-card-height-desktop: {{ section.settings.block_height_desktop }}px;
    {% if section.settings.title_font_size_mobile != blank %}--ew-rhz-title-font-size-mobile: {{ section.settings.title_font_size_mobile }};{% endif %}
    {% if section.settings.subtitle_font_size_mobile != blank %}--ew-rhz-subtitle-font-size-mobile: {{ section.settings.subtitle_font_size_mobile }};{% endif %}
    --ew-rhz-mobile-card-size: {{ section.settings.mobile_card_size }};
  "
>
  <div class="ew-rhz-curated-cards__inner">
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="ew-rhz-curated-cards__header" style="--header-alignment: {{ section.settings.header_alignment }}; --text-align: {{ section.settings.header_alignment | replace: 'flex-start', 'left' | replace: 'flex-end', 'right' | replace: 'center', 'center' }};">
        {% if section.settings.title != blank %}
          <h2
            class="ew-rhz-curated-cards__title text-block {{ section.settings.title_preset }}"
            style="{% render 'typography-style', settings: section.settings, preset: section.settings.title_preset %}{% if section.settings.title_color != blank %} color: {{ section.settings.title_color }};{% endif %}"
          >
            <span>{{ section.settings.title | escape }}</span>
          </h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p
            class="ew-rhz-curated-cards__subtitle text-block {{ section.settings.subtitle_preset }}"
            style="{% render 'typography-style', settings: section.settings, preset: section.settings.subtitle_preset %}{% if section.settings.subtitle_color != blank %} color: {{ section.settings.subtitle_color }};{% endif %}"
          >
            <span>{{ section.settings.subtitle | escape }}</span>
          </p>
        {% endif %}
      </div>
    {% endif %}

    {% capture card_blocks %}
      {% for block in section.blocks %}
        {% if block.type == 'card' %}
          <div class="ew-rhz-curated-cards__card" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="ew-rhz-curated-cards__link">
            {% endif %}
            <div class="ew-rhz-curated-cards__media">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000, 1200',
                    sizes: '(min-width: 750px) calc((100vw - var(--page-margin) * 2) / 3), var(--ew-rhz-mobile-card-size, 80vw)',
                    class: 'ew-rhz-curated-cards__img'
                }}
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'ew-rhz-curated-cards__placeholder' }}
              {% endif %}
              {% if block.settings.label != blank %}
                <div
                  class="ew-rhz-curated-cards__label"
                  style="
                    --label-align: {{ block.settings.label_alignment }};
                    --label-color: {{ block.settings.label_color }};
                    --label-bg: rgba({{ block.settings.label_background_color.red }}, {{ block.settings.label_background_color.green }}, {{ block.settings.label_background_color.blue }}, {{ block.settings.label_background_opacity | divided_by: 100.0 }});
                  "
                >
                  <span class="ew-rhz-curated-cards__label-text">{{ block.settings.label | escape }}</span>
                </div>
              {% endif %}
            </div>
            {% if block.settings.link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    {% endcapture %}

    <div class="ew-rhz-curated-cards__grid ew-rhz-curated-cards__grid--desktop{% if section.settings.carousel_on_mobile %} ew-rhz-curated-cards__grid--hide-mobile{% endif %}">
      {{ card_blocks }}
    </div>

    {% if section.settings.carousel_on_mobile %}
      <div class="ew-rhz-curated-cards__carousel ew-rhz-curated-cards__carousel--mobile" id="ew-rhz-curated-cards-splide-{{ section.id }}">
        <div class="splide" id="ew-rhz-curated-splide-{{ section.id }}">
          <div class="splide__track">
            <ul class="splide__list">
              {% for block in section.blocks %}
                {% if block.type == 'card' %}
                  <li class="splide__slide" {{ block.shopify_attributes }}>
                    <div class="ew-rhz-curated-cards__card">
                      {% if block.settings.link != blank %}
                        <a href="{{ block.settings.link }}" class="ew-rhz-curated-cards__link">
                      {% endif %}
                      <div class="ew-rhz-curated-cards__media">
                        {% if block.settings.image != blank %}
                          {{
                            block.settings.image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '400, 600, 800, 1000, 1200',
                              sizes: 'var(--ew-rhz-mobile-card-size, 80vw)',
                              class: 'ew-rhz-curated-cards__img'
                          }}
                        {% else %}
                          {{ 'lifestyle-1' | placeholder_svg_tag: 'ew-rhz-curated-cards__placeholder' }}
                        {% endif %}
                        {% if block.settings.label != blank %}
                          <div
                            class="ew-rhz-curated-cards__label"
                            style="
                              --label-align: {{ block.settings.label_alignment }};
                              --label-color: {{ block.settings.label_color }};
                              --label-bg: rgba({{ block.settings.label_background_color.red }}, {{ block.settings.label_background_color.green }}, {{ block.settings.label_background_color.blue }}, {{ block.settings.label_background_opacity | divided_by: 100.0 }});
                            "
                          >
                            <span class="ew-rhz-curated-cards__label-text">{{ block.settings.label | escape }}</span>
                          </div>
                        {% endif %}
                      </div>
                      {% if block.settings.link != blank %}
                        </a>
                      {% endif %}
                    </div>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
      <script>
        (function () {
          var splideInstance = null;
          var selector = '#ew-rhz-curated-splide-{{ section.id }}';
          var cardCount = {{ section.blocks | where: 'type', 'card' | size }};
          var resizeTimeout;

          function onResize() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(function () {
              if (splideInstance && typeof splideInstance.refresh === 'function') {
                splideInstance.refresh();
              }
            }, 150);
          }

          function init() {
            var el = document.querySelector(selector);
            if (!el || cardCount === 0 || typeof Splide === 'undefined') return;
            window.removeEventListener('resize', onResize);
            if (splideInstance) {
              try { splideInstance.destroy(); } catch (_) {}
              splideInstance = null;
            }
            splideInstance = new Splide(selector, {
              type: 'slide',
              fixedWidth: '{{ section.settings.mobile_card_size }}',
              gap: '{{ section.settings.carousel_gap }}px',
              arrows: {{ section.settings.carousel_arrows }},
              pagination: {{ section.settings.carousel_pagination }},
              autoplay: {{ section.settings.carousel_autoplay }},
              interval: {{ section.settings.carousel_autoplay_interval | times: 1000 }},
              rewind: true,
              /* Avoid skipped slides: default trimSpace can leave the track stuck between indices on peek layouts */
              trimSpace: 'move',
              flickMaxPages: 1,
              flickPower: 280,
              dragMinThreshold: { touch: 12, mouse: 4 }
            }).mount();

            window.addEventListener('resize', onResize);
          }

          function run() { init(); }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', run);
          } else {
            run();
          }

          document.addEventListener('shopify:section:load', function (e) {
            if (e.target && e.target.querySelector && e.target.querySelector(selector)) {
              run();
            }
          });
        })();
      </script>
    {% endif %}

    {% if section.settings.show_view_all and section.settings.view_all_label != blank and section.settings.view_all_link != blank %}
      <div
        class="ew-rhz-curated-cards__footer"
        style="--ew-rhz-view-all-align: {{ section.settings.view_all_alignment }}; --ew-rhz-view-all-spacing-top: {{ section.settings.view_all_spacing_top }}px;"
      >
        <a
          href="{{ section.settings.view_all_link }}"
          class="ew-rhz-curated-cards__view-all button{% if section.settings.view_all_style == 'secondary' %} button-secondary{% endif %}"
        >
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .ew-rhz-curated-cards__footer {
    display: flex;
    justify-content: var(--ew-rhz-view-all-align, center);
    width: 100%;
    margin-top: var(--ew-rhz-view-all-spacing-top, 24px);
  }

  .ew-rhz-curated-cards__view-all {
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Curated Cards",
  "tag": "section",
  "class": "ew-rhz-curated-cards-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "CURATED THIS SEASON"
    },
    {
      "type": "select",
      "id": "title_preset",
      "label": "Title preset",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "A blend of classic silhouettes and our signature shine."
    },
    {
      "type": "select",
      "id": "subtitle_preset",
      "label": "Subtitle preset",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" },
        { "value": "paragraph", "label": "Paragraph" }
      ],
      "default": "paragraph"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color"
    },
    {
      "type": "select",
      "id": "title_font_size_mobile",
      "label": "Title font size (mobile)",
      "info": "Applies on screens under 750px. Choose Default to use the title preset size.",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" },
        { "value": "1.25rem", "label": "20px" },
        { "value": "1.5rem", "label": "24px" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "subtitle_font_size_mobile",
      "label": "Subtitle font size (mobile)",
      "info": "Applies on screens under 750px. Choose Default to use the subtitle preset size.",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "0.75rem", "label": "12px" },
        { "value": "0.875rem", "label": "14px" },
        { "value": "1rem", "label": "16px" },
        { "value": "1.125rem", "label": "18px" }
      ],
      "default": ""
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "header_gap_mobile",
      "label": "Title–subtitle gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_gap_desktop",
      "label": "Title–subtitle gap (desktop)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_spacing_mobile",
      "label": "Header–cards spacing (mobile)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_spacing_desktop",
      "label": "Header–cards spacing (desktop)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "block_height_mobile",
      "label": "Card height (mobile)",
      "min": 200,
      "max": 800,
      "step": 20,
      "default": 400,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_height_desktop",
      "label": "Card height (desktop)",
      "min": 300,
      "max": 900,
      "step": 20,
      "default": 520,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_card_size",
      "label": "Mobile card size",
      "options": [
        { "value": "85vw", "label": "Large (1 card)" },
        { "value": "75vw", "label": "Medium" },
        { "value": "60vw", "label": "Small (1.5 visible)" }
      ],
      "default": "75vw"
    },
    {
      "type": "checkbox",
      "id": "carousel_arrows",
      "label": "Carousel arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_pagination",
      "label": "Carousel pagination",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "carousel_autoplay",
      "label": "Carousel autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "carousel_autoplay_interval",
      "label": "Autoplay interval (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "carousel_gap",
      "label": "Carousel gap (mobile)",
      "min": 0,
      "max": 32,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "label": "Gap between cards (desktop)",
      "min": 0,
      "max": 48,
      "step": 4,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button label",
      "default": "View all",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary" },
        { "value": "secondary", "label": "Secondary" }
      ],
      "default": "secondary",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "view_all_alignment",
      "label": "Button alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "range",
      "id": "view_all_spacing_top",
      "label": "Space above button",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px",
      "visible_if": "{{ section.settings.show_view_all }}"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "full-width", "label": "Full width" },
        { "value": "page-width", "label": "Page width" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label text",
          "default": "Category"
        },
        {
          "type": "select",
          "id": "label_alignment",
          "label": "Label alignment",
          "options": [
            { "value": "flex-start", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "flex-end", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "color",
          "id": "label_color",
          "label": "Label text color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "label_background_color",
          "label": "Label background color",
          "default": "#222222"
        },
        {
          "type": "range",
          "id": "label_background_opacity",
          "label": "Label background opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 60,
          "unit": "%"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Curated Cards",
      "category": "Media",
      "blocks": [
        { "type": "card", "settings": { "label": "Printed" } },
        { "type": "card", "settings": { "label": "Luxury lawn" } },
        { "type": "card", "settings": { "label": "Festive" } }
      ]
    }
  ]
}
{% endschema %}
