                                  render 'header-option-item__search', header_settings: section.settings

                                  if show_language_switcher
                                    render 'language-switcher', box_size: 'hidden xl:block'
                                  endif

                                  if show_currency_switcher
                                    render 'currency-switcher', box_size: 'hidden xl:block'
                                  endif

                                  if show_country_selector
                                    render 'country-selector', box_size: 'hidden xl:block'
                                  endif

                                  if show_account_icon
                                    render 'header-option-item__account', display_by: 'icon'
                                  endif

                                  if show_wishlist_icon
                                    render 'header-option-item__wishlist', display_by: 'icon'
                                  endif

                                  if show_compare_icon
                                    render 'header-option-item__compare', display_by: 'icon'
                                  endif

                                  if show_cart_icon
                                    render 'cart'
                                  endif
                                %}
                            </div>
                        </div>
                    </div>
                    {% assign box_size = container | append: ' -mx-4' %}
                    <div class="sf-menu-bar bg-color-menubar-background text-color-menubar">
                        {% render 'header-main-menu-container', section: section, box_size: box_size %}
                    </div>
            {% endcase %}
        </header>
    </div>

    {% liquid
        assign main_menu = section.settings.main_menu
        assign mobile_menu = section.settings.mobile_menu
        
        if mobile_menu == blank
            assign menu = main_menu
        else
            assign menu = mobile_menu
        endif
    %}

    <div
        style="--tw-bg-opacity: 0;"
        class="sf-menu-wrapper sf-menu-wrapper-mobile touch-none hidden fixed z-[80] inset-0 transition-colors duration-300 bg-black"
    >
        <div class="sf-menu__content overscroll-contain transition-transform -translate-x-full duration-300 md:w-[450px] z-50 bg-white text-black overflow-x-hidden h-full overflow-y-scroll">
            <div class="flex flex-col">
                <div class="sf-menu-content flex-grow flex flex-col justify-between transition-all opacity-0 opacity-100 duration-300">
                    <div class="w-full sf-menu-links pt-8">
                    {% for link in linklists[menu].links %}
                        {% if link.links != blank %}
                            <li class="list-none sf-link flex items-center" data-url="{{ link.url }}">
                                <a href="{{ link.url }}" class="w-full px-4 py-3 flex items-center justify-between relative"{% if link.url contains '#' %} data-toggle-submenu="1"{% endif %}>
                                    <span>{{ link.title }}</span>
                                </a>
                                <span class="sf__toggle-submenu-mb flex items-center justify-center" data-toggle-submenu="1">
                                  <svg class="w-[16px] h-[16px]" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path d="M17.525 36.465l-7.071 7.07c-4.686 4.686-4.686 12.284 0 16.971L205.947 256 10.454 451.494c-4.686 4.686-4.686 12.284 0 16.971l7.071 7.07c4.686 4.686 12.284 4.686 16.97 0l211.051-211.05c4.686-4.686 4.686-12.284 0-16.971L34.495 36.465c-4.686-4.687-12.284-4.687-16.97 0z"/></svg>
                                </span>
                                <div class="sf-sub-links hidden absolute inset-y-0 bg-white flex-col left-full w-full">
                                    <div class="h-full overflow-y-scroll overscroll-contain">
                                        <button class="back p-4 font-medium flex items-center" data-level="1">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="w-[16px] h-[16px]" fill="none" viewBox="0 0 16 17"><path fill="currentColor" d="M8.12109 15.9141c-.21093.1875-.41015.1875-.59765 0L.175781 8.53125c-.210937-.1875-.210937-.375 0-.5625L7.52344.585938c.1875-.1875.38672-.1875.59765 0l.70313.703122c.1875.1875.1875.38672 0 .59766L3.375 7.33594h11.9883c.2812 0 .4219.14062.4219.42187v.98438c0 .28125-.1407.42187-.4219.42187H3.375l5.44922 5.44924c.1875.2109.1875.4101 0 .5976l-.70313.7032z"/></svg>
                                        <span class="ml-3">{% render 'new-locale', key: 'layout.back' %}</span>
                                        </button>
                                    <ul class="sf-sub-links--level-2 pb-4">
                                        {% for child in link.links %}
                                        <li class="list-none sf-link flex items-center" data-url="{{ link.url }}">
                                            <a href="{{ child.url }}" class="w-full px-4 py-3 flex items-center justify-between relative"{% if child.url contains '#' %} data-toggle-submenu="2"{% endif %}>
                                            <span>{{ child.title }}</span>
                                            </a>
                                            {% if child.links != blank %}
                                            <span class="sf__toggle-submenu-mb flex items-center justify-center" data-toggle-submenu="2">
                                              <svg class="w-[16px] h-[16px]" fill="currentColor" stroke="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512"><path d="M17.525 36.465l-7.071 7.07c-4.686 4.686-4.686 12.284 0 16.971L205.947 256 10.454 451.494c-4.686 4.686-4.686 12.284 0 16.971l7.071 7.07c4.686 4.686 12.284 4.686 16.97 0l211.051-211.05c4.686-4.686 4.686-12.284 0-16.971L34.495 36.465c-4.686-4.687-12.284-4.687-16.97 0z"/></svg>
                                            </span>
                                            <div class="sf-sub-links hidden absolute inset-y-0 bg-white flex-col left-full w-full">
                                            <div class="h-full overflow-y-scroll overscroll-contain">
                                                <button class="back p-4 font-medium flex items-center" data-level="2">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="w-[16px] h-[16px]" fill="none" viewBox="0 0 16 17"><path fill="currentColor" d="M8.12109 15.9141c-.21093.1875-.41015.1875-.59765 0L.175781 8.53125c-.210937-.1875-.210937-.375 0-.5625L7.52344.585938c.1875-.1875.38672-.1875.59765 0l.70313.703122c.1875.1875.1875.38672 0 .59766L3.375 7.33594h11.9883c.2812 0 .4219.14062.4219.42187v.98438c0 .28125-.1407.42187-.4219.42187H3.375l5.44922 5.44924c.1875.2109.1875.4101 0 .5976l-.70313.7032z"/></svg>
                                                <span class="ml-3">{% render 'new-locale', key: 'layout.back' %}</span>
                                                </button>
                                                <ul class="sf-sub-links--level-2 pb-4">
                                                {% render 'mega-menu-link' for child.links as link %}
                                                </ul>
                                            </div>
                                            </div>
                                            {% endif %}
                                        </li>
                                        {% endfor %}
                                    </ul>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                        {% render 'mega-menu-link' with link as link %}
                        {% endif %}
                    {% endfor %}
                    </div>
                {% render 'mega-menu-customer', section: section %}
                </div>
            </div>
        </div>
    </div>


    <div class="sf-header__overlay hidden md:block pointer-events-none fixed bg-black -inset-0" style="--tw-bg-opacity: 0.6;" ></div>
    {% render 'search-popup', header_settings: section.settings %}
</section>

