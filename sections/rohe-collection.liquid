<div class="rohe-collection-wrapper">
  <div class="section section--full-width section--full-width-margin">
    <div class="action-bar">
      <div class="bar-item bar-left">
        <button id="filterToggle" class="filter-trigger">
          <span id="filterIcon" class="filter-icon-swap">
            <span class="filter-icon-filter">
              <svg width="22" height="22" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <path d="M3.5 8.16667H7M3.5 19.8333H10.5M21 19.8333L24.5 19.8333M17.5 8.16667L24.5 8.16667" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="10.5" cy="8.16667" r="3.5" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="19.8333" r="3.5" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </span>
            <span class="filter-icon-close">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6L6 18M6 6l12 12"/>
              </svg>
            </span>
          </span>
          <span class="btn-text">FILTERS</span>
        </button>
      </div>
      <header class="rohe-main--desktop-header">
        <h1 class="main-collection--desktop-title main-collection-title">{{ collection.title }}</h1>
      </header>

      <div class="bar-item bar-center mobile-only">
        <div class="grid-controls-mobile">
          <div class="g-icon-m" data-cols="1"><span></span></div>
          <div class="g-icon-m active" data-cols="2"><span></span><span></span></div>
        </div>
      </div>

      <div class="bar-item bar-right">
        <div class="action-right-content">
          <div class="grid-controls desktop-only">
            <div class="g-icon active" data-cols="4"><span></span><span></span><span></span><span></span></div>
            <div class="g-icon" data-cols="3"><span></span><span></span><span></span></div>
          </div>

          <div class="sort-wrapper">
            <button id="sortBtn" class="filter-trigger">
              <span class="btn-text">SORT BY</span>
              <svg width="10" height="10" viewBox="0 0 12 12">
                <path d="M2.5 4.5L6 8l3.5-3.5" stroke="black" stroke-width="1.2" fill="none"/>
              </svg>
            </button>
            <div id="sortMenu" class="sort-dropdown">
              {%- for option in collection.sort_options -%}
                <a href="{{ request.path }}?sort_by={{ option.value }}">{{ option.name }}</a>
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>

    <header class="rohe-main-header">
      <h1 class="main-collection-title">{{ collection.title }}</h1>
    </header>

    {%- assign has_any_active = false -%}
    {%- for filter in collection.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != null or filter.max_value.value != null -%}
          {%- assign has_any_active = true -%}
          {%- break -%}
        {%- endif -%}
      {%- else -%}
        {%- if filter.active_values.size > 0 -%}
          {%- assign has_any_active = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_any_active -%}
      <div class="active-filters-bar">
        <div class="active-filters-inner">
          <span class="active-filters-label">Active:</span>
          <div class="active-filters-pills">
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                  <a href="{{ filter.url_to_remove }}" class="active-filter-pill" aria-label="{{ 'actions.remove' | t }} {{ filter.label }}">
                    {%- if filter.min_value.value != null and filter.max_value.value != null -%}
                      {{ filter.min_value.value | money }} – {{ filter.max_value.value | money }}
                    {%- elsif filter.min_value.value != null -%}
                      {{ filter.min_value.value | money }} – {{ filter.range_max | money }}
                    {%- elsif filter.max_value.value != null -%}
                      {{ 0 | money }} – {{ filter.max_value.value | money }}
                    {%- endif -%}
                    <span class="active-filter-pill-x" aria-hidden="true">&times;</span>
                  </a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <a href="{{ value.url_to_remove }}" class="active-filter-pill" aria-label="{{ 'actions.remove' | t }} {{ value.label }}">
                    {{ value.label }}
                    <span class="active-filter-pill-x" aria-hidden="true">&times;</span>
                  </a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <a href="{{ collection.url }}{% if collection.sort_by != collection.default_sort_by %}?sort_by={{ collection.sort_by }}{% endif %}" class="active-filters-clear-all">
            {{ 'actions.clear_all' | t | default: 'Clear all' }}
          </a>
        </div>
      </div>
    {%- endif -%}

    <div class="main-layout-container">
      <aside id="sideDrawer" class="filter-sidebar desktop-only">
        {% for filter in collection.filters %}
          {% assign has_active = false %}
          {% if filter.type == 'price_range' %}
            {% if filter.min_value.value != null or filter.max_value.value != null %}
              {% assign has_active = true %}
            {% endif %}
          {% else %}
            {% for value in filter.values %}
              {% if value.active %}{% assign has_active = true %}{% break %}{% endif %}
            {% endfor %}
          {% endif %}
          <details class="filter-accordion__item" {% if has_active or forloop.first %}open{% endif %}>
            <summary class="filter-accordion__header">
              <span class="filter-accordion__label">{{ filter.label }}</span>
              <svg class="filter-accordion__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="filter-accordion__content">
              {% if filter.type == 'price_range' %}
                <form class="price-range-form" data-min-param="{{ filter.min_value.param_name }}" data-max-param="{{ filter.max_value.param_name }}" data-range-max="{{ filter.range_max | money_without_currency }}">
                  <div class="price-range-inputs">
                    <input type="text" inputmode="decimal" class="price-range-input" name="min" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency }}"{% endif %} data-min="0" data-max="{{ filter.range_max | money_without_currency }}" autocomplete="off">
                    <span class="price-range-sep">–</span>
                    <input type="text" inputmode="decimal" class="price-range-input" name="max" placeholder="{{ filter.range_max | money_without_currency }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency }}"{% endif %} data-min="0" data-max="{{ filter.range_max | money_without_currency }}" autocomplete="off">
                  </div>
                  {%- assign formatted_highest_price = filter.range_max | money -%}
                  <p class="price-range-hint">{{ 'content.price_filter_html' | t: price: formatted_highest_price }}</p>
                  <button type="submit" class="price-range-apply">{{ 'actions.apply' | t | default: 'Apply' }}</button>
                </form>
              {% else %}
                {% for value in filter.values %}
                  <label class="check-row">
                    <input
                      type="checkbox"
                      {% if value.active %}
                        checked
                      {% endif %}
                      onchange="window.location.href = this.checked ? '{{ value.url_to_add }}' : '{{ value.url_to_remove }}'"
                    >
                    {{ value.label }} ({{ value.count }})
                  </label>
                {% endfor %}
              {% endif %}
            </div>
          </details>
        {% endfor %}
      </aside>

      {% paginate collection.products by section.settings.products_per_page %}
      <main
        id="mainGrid"
        class="rohe-product-grid columns-4 m-columns-2"
        data-last-page="{{ paginate.pages }}"
        data-current-page="{{ paginate.current_page }}"
        data-section-id="{{ section.id }}"
      >
        {%- for product in collection.products -%}
          <div class="Featured-product__card" data-page="{{ paginate.current_page }}">
            <div class="Featured-product__image-wrapper">
              {%- if product.available == false -%}
                <span class="Featured-product__badge Featured-product__badge--sold-out">Sold Out</span>
              {%- elsif product.compare_at_price > product.price -%}
                <span class="Featured-product__badge Featured-product__badge--sale">Best Seller</span>
              {%- endif -%}

              <a href="{{ product.url }}" class="Featured-product__link">
                <img
                  src="{{ product.featured_image | img_url: '800x' }}"
                  class="Featured-product__img Featured-product__img--primary"
                  alt="{{ product.title }}"
                  loading="lazy"
                >
                {% if product.images[1] %}
                  <img
                    src="{{ product.images[1] | img_url: '800x' }}"
                    class="Featured-product__img Featured-product__img--secondary"
                    alt="{{ product.title }}"
                    loading="lazy"
                  >
                {% endif %}
              </a>

              {%- assign product_form_id = 'RoheCollectionForm-'
                | append: section.id
                | append: '-'
                | append: product.id
              -%}
              <product-form-component
                id="{{ product_form_id }}"
                data-section-id="{{ section.id }}"
                data-product-id="{{ product.id }}"
                data-quantity-default="1"
                class="Featured-product__form-wrapper"
              >
                <div
                  class="visually-hidden"
                  aria-live="assertive"
                  role="status"
                  aria-atomic="true"
                  ref="liveRegion"
                ></div>
                <form
                  id="{{ product_form_id }}-form"
                  method="post"
                  action="{{ routes.cart_add_url }}"
                  data-type="add-to-cart-form"
                  class="Featured-product__form"
                  novalidate
                >
                  <input
                    type="hidden"
                    name="id"
                    ref="variantId"
                    value="{{ product.selected_or_first_available_variant.id }}"
                  >
                  <input type="hidden" name="quantity" value="1">
                  <add-to-cart-component ref="addToCartButtonContainer">
                    <button
                      type="submit"
                      name="add"
                      ref="addToCartButton"
                      class="Featured-product__action-btn"
                      {% unless product.available %}
                        disabled
                      {% endunless %}
                    >
                      <span class="Featured-product__action-btn-content">
                        <span class="Featured-product__add-text">ADD</span>
                        {{- 'add-to-cart-icon.svg' | inline_asset_content -}}
                      </span>
                      <span class="Featured-product__action-btn-loading" aria-hidden="true">
                        <span class="Featured-product__action-btn-spinner"></span>
                      </span>
                    </button>
                  </add-to-cart-component>
                </form>
              </product-form-component>
            </div>

            <div class="Featured-product__info">
              <div class="Featured-product__details">
                <h3 class="Featured-product__title">{{ product.title }}</h3>
              </div>
              <div class="Featured-product__price">
                {% render 'price', product_resource: product %}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </main>
      {% if section.settings.enable_infinite_scroll and paginate.pages > 1 %}
        <div class="rohe-infinite-scroll-footer">
          <div class="rohe-infinite-scroll-sentinel" aria-hidden="true"></div>
          <div class="rohe-infinite-scroll-loading" aria-hidden="true" style="display:none; text-align:center; padding: 1.5rem;">
            <span class="rohe-infinite-scroll-spinner"></span>
            <span>Loading more…</span>
          </div>
        </div>
      {% endif %}
      {% endpaginate %}
    </div>

    <div id="m-filter-drawer" class="m-drawer-overlay">
      <div class="m-drawer-inner">
        <div class="m-drawer-head">
          <span style="font-weight:600;">FILTERS</span>
          <button id="m-close-x" class="m-close-x">&times;</button>
        </div>
        <div class="m-drawer-body">
          {% for filter in collection.filters %}
            {% assign has_active_m = false %}
            {% if filter.type == 'price_range' %}
              {% if filter.min_value.value != null or filter.max_value.value != null %}
                {% assign has_active_m = true %}
              {% endif %}
            {% else %}
              {% for value in filter.values %}
                {% if value.active %}{% assign has_active_m = true %}{% break %}{% endif %}
              {% endfor %}
            {% endif %}
            <details class="filter-accordion__item filter-accordion__item--mobile" {% if has_active_m or forloop.first %}open{% endif %}>
              <summary class="filter-accordion__header">
                <span class="filter-accordion__label">{{ filter.label }}</span>
                <svg class="filter-accordion__chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>
              <div class="filter-accordion__content m-f-options">
                {% if filter.type == 'price_range' %}
                  <form class="price-range-form" data-min-param="{{ filter.min_value.param_name }}" data-max-param="{{ filter.max_value.param_name }}" data-range-max="{{ filter.range_max | money_without_currency }}">
                    <div class="price-range-inputs">
                      <input type="text" inputmode="decimal" class="price-range-input" name="min" placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency }}"{% endif %} data-min="0" data-max="{{ filter.range_max | money_without_currency }}" autocomplete="off">
                      <span class="price-range-sep">–</span>
                      <input type="text" inputmode="decimal" class="price-range-input" name="max" placeholder="{{ filter.range_max | money_without_currency }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency }}"{% endif %} data-min="0" data-max="{{ filter.range_max | money_without_currency }}" autocomplete="off">
                    </div>
                    {%- assign formatted_highest_price_m = filter.range_max | money -%}
                    <p class="price-range-hint">{{ 'content.price_filter_html' | t: price: formatted_highest_price_m }}</p>
                    <button type="submit" class="price-range-apply">{{ 'actions.apply' | t | default: 'Apply' }}</button>
                  </form>
                {% else %}
                  {% for value in filter.values %}
                    <label class="m-check-label">
                      <input
                        type="checkbox"
                        {% if value.active %}
                          checked
                        {% endif %}
                        onchange="window.location.href = this.checked ? '{{ value.url_to_add }}' : '{{ value.url_to_remove }}'"
                      >
                      <span>{{ value.label }} ({{ value.count }})</span>
                    </label>
                  {% endfor %}
                {% endif %}
              </div>
            </details>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .rohe-collection-wrapper .Featured-product__action-btn {
    position: relative;
    transition: opacity 0.25s ease, transform 0.2s ease;
  }
  .rohe-collection-wrapper .Featured-product__action-btn:active:not(:disabled) {
    opacity: 0.85;
    transform: scale(0.98);
  }
  .rohe-collection-wrapper .Featured-product__action-btn-content,
  .rohe-collection-wrapper .Featured-product__action-btn-loading {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
  }
  .rohe-collection-wrapper .Featured-product__action-btn-loading {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .rohe-collection-wrapper .Featured-product__action-btn.is-loading .Featured-product__action-btn-content {
    opacity: 0;
    pointer-events: none;
  }
  .rohe-collection-wrapper .Featured-product__action-btn.is-loading .Featured-product__action-btn-loading {
    opacity: 1;
  }
  .rohe-collection-wrapper .Featured-product__action-btn-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: rohe-collection-spin 0.6s linear infinite;
  }
  @keyframes rohe-collection-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .rohe-collection-wrapper .main-layout-container {
    flex-wrap: wrap;
  }
  .rohe-infinite-scroll-footer {
    flex-basis: 100%;
    width: 100%;
    min-height: 1px;
  }
  .rohe-infinite-scroll-sentinel {
    height: 1px;
    width: 100%;
    pointer-events: none;
    visibility: hidden;
  }
  .rohe-infinite-scroll-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1.5rem;
  }
  .rohe-infinite-scroll-spinner {
    width: 24px;
    height: 24px;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: rohe-collection-spin 0.6s linear infinite;
  }
</style>

<script>
  (function () {
    var sectionId = '{{ section.id }}';
    var sectionEl =
      document.getElementById('shopify-section-' + sectionId) || document.querySelector('.rohe-collection-wrapper');
    if (!sectionEl) return;

    function clearLoading() {
      sectionEl.querySelectorAll('.Featured-product__action-btn.is-loading').forEach(function (b) {
        b.classList.remove('is-loading');
      });
    }

    sectionEl.addEventListener(
      'submit',
      function (e) {
        var form = e.target.closest('form[data-type="add-to-cart-form"]');
        if (!form || !sectionEl.contains(form)) return;
        e.preventDefault();
        e.stopPropagation();
        var btn = form.querySelector('.Featured-product__action-btn');
        if (btn && btn.disabled) return;
        if (btn) btn.classList.add('is-loading');
        setTimeout(clearLoading, 4000);

        var formData = new FormData(form);
        var cartAddUrl =
          (window.Theme && window.Theme.routes && window.Theme.routes.cart_add_url) ||
          '{{ routes.cart_add_url | append: ".js" }}';

        fetch(cartAddUrl, {
          method: 'POST',
          body: formData,
          headers: {
            Accept: 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
          },
          credentials: 'same-origin',
        })
          .then(function (res) {
            return res.json();
          })
          .then(function (data) {
            clearLoading();
            if (data.status && data.status !== 200) {
              alert(data.message || 'Unable to add to cart.');
              return;
            }
            var formComponent = form.closest('product-form-component');
            var itemCount = parseInt(formData.get('quantity') || '1', 10);
            document.dispatchEvent(
              new CustomEvent('cart:update', {
                bubbles: true,
                detail: {
                  resource: data,
                  data: {
                    source: 'product-form-component',
                    itemCount: itemCount,
                    productId: formComponent ? formComponent.getAttribute('data-product-id') : null,
                  },
                },
              })
            );
          })
          .catch(function (err) {
            console.error('Add to cart error:', err);
            clearLoading();
            alert('Unable to add to cart. Please try again.');
          });
      },
      true
    );

    document.addEventListener('cart:update', clearLoading);
    document.addEventListener('cart:error', clearLoading);
  })();
</script>

<script>
  (function () {
    var sentinel = document.querySelector('.rohe-infinite-scroll-sentinel');
    var grid = document.getElementById('mainGrid');
    var loadingEl = document.querySelector('.rohe-infinite-scroll-loading');
    if (!sentinel || !grid || !grid.dataset.sectionId) return;

    var sectionId = grid.dataset.sectionId;
    var lastPage = parseInt(grid.dataset.lastPage, 10) || 1;
    var loading = false;

    function getCurrentPage() {
      return parseInt(grid.dataset.currentPage, 10) || 1;
    }

    function appendNextPage() {
      if (loading) return;
      var currentPage = getCurrentPage();
      if (currentPage >= lastPage) return;

      loading = true;
      if (loadingEl) loadingEl.style.display = 'flex';

      var nextPage = currentPage + 1;
      var url = new URL(window.location.href);
      url.searchParams.set('page', String(nextPage));
      url.hash = '';

      fetch(url.toString(), { headers: { Accept: 'text/html' } })
        .then(function (res) { return res.text(); })
        .then(function (html) {
          var parser = new DOMParser();
          var doc = parser.parseFromString(html, 'text/html');
          var section = doc.getElementById('shopify-section-' + sectionId);
          if (!section) {
            var fallback = doc.querySelector('.rohe-collection-wrapper');
            section = fallback;
          }
          if (!section) return;
          var newGrid = section.querySelector('#mainGrid');
          if (!newGrid) return;
          var cards = newGrid.querySelectorAll('.Featured-product__card');
          for (var i = 0; i < cards.length; i++) {
            grid.appendChild(cards[i].cloneNode(true));
          }
          grid.dataset.currentPage = String(nextPage);
          if (nextPage >= lastPage) {
            var footer = sentinel.closest('.rohe-infinite-scroll-footer');
            if (footer && footer.parentNode) footer.parentNode.removeChild(footer);
          }
        })
        .catch(function (err) {
          console.error('Rohe infinite scroll error:', err);
        })
        .finally(function () {
          loading = false;
          if (loadingEl) loadingEl.style.display = 'none';
        });
    }

    var observer = new IntersectionObserver(
      function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            appendNextPage();
            break;
          }
        }
      },
      { rootMargin: '200px', threshold: 0 }
    );
    observer.observe(sentinel);
  })();
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Grid Logic Fix
    document.querySelectorAll('.g-icon, .g-icon-m').forEach((icon) => {
      icon.addEventListener('click', function () {
        const cols = this.dataset.cols;
        const grid = document.getElementById('mainGrid');

        if (window.innerWidth <= 768) {
          grid.classList.remove('m-columns-1', 'm-columns-2');
          grid.classList.add('m-columns-' + cols);
        } else {
          grid.classList.remove('columns-3', 'columns-4');
          grid.classList.add('columns-' + cols);
        }

        this.parentElement.querySelectorAll('.active').forEach((a) => a.classList.remove('active'));
        this.classList.add('active');
      });
    });

    // Open filter by default when any filter is active (desktop: sidebar only; mobile: drawer only)
    var sideDrawer = document.getElementById('sideDrawer');
    var mFilterDrawer = document.getElementById('m-filter-drawer');
    var filterToggle = document.getElementById('filterToggle');

    var hasActiveFilters = window.location.search.indexOf('filter') !== -1;
    if (hasActiveFilters) {
      if (window.innerWidth > 768) {
        if (sideDrawer) sideDrawer.classList.add('open');
      } else {
        if (mFilterDrawer) mFilterDrawer.classList.add('m-is-open');
      }
    }

    function updateFilterIcon() {
      var isOpen = (sideDrawer && sideDrawer.classList.contains('open')) ||
                   (mFilterDrawer && mFilterDrawer.classList.contains('m-is-open'));
      filterToggle.classList.toggle('is-open', !!isOpen);
    }

    // Sidebar & Drawer Toggle
    filterToggle.onclick = function () {
      if (window.innerWidth <= 768) {
        mFilterDrawer.classList.add('m-is-open');
      } else {
        sideDrawer.classList.toggle('open');
      }
      updateFilterIcon();
    };

    document.getElementById('m-close-x').onclick = function () {
      mFilterDrawer.classList.remove('m-is-open');
      updateFilterIcon();
    };

    updateFilterIcon();

    // Price range form
    document.querySelectorAll('.price-range-form').forEach(function (form) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var minParam = form.dataset.minParam;
        var maxParam = form.dataset.maxParam;
        var minInput = form.querySelector('input[name="min"]');
        var maxInput = form.querySelector('input[name="max"]');
        var minVal = minInput && minInput.value.trim() ? parseFloat(String(minInput.value).replace(/,/g, '')) : null;
        var maxVal = maxInput && maxInput.value.trim() ? parseFloat(String(maxInput.value).replace(/,/g, '')) : null;
        var url = new URL(window.location.href);
        if (minVal != null) url.searchParams.set(minParam, String(minVal)); else url.searchParams.delete(minParam);
        if (maxVal != null) url.searchParams.set(maxParam, String(maxVal)); else url.searchParams.delete(maxParam);
        url.searchParams.delete('page');
        window.location.href = url.toString();
      });
    });

    // Sort Toggle
    const sortBtn = document.getElementById('sortBtn');
    const sortMenu = document.getElementById('sortMenu');
    sortBtn.onclick = (e) => {
      e.stopPropagation();
      sortMenu.classList.toggle('active');
    };
    window.onclick = () => sortMenu.classList.remove('active');
  });
</script>

{% schema %}
{
  "name": "Rohe Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 50,
      "step": 1,
      "label": "Products per page",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "label": "Enable infinite scroll",
      "default": true
    }
  ],
  "presets": [{ "name": "Rohe Collection Grid" }]
}
{% endschema %}
