{% comment %}
  Size guide block – desktop only. Opens popup with product metafield custom.size_guide_image.
  The dialog is rendered once by the section/snippet (ew-size-guide-dialog); this block only outputs the trigger button.
{% endcomment %}

{% liquid
  assign product_resource = closest.product | default: product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
  assign size_guide_image = product_resource.metafields.custom.size_guide_image.value
  if size_guide_image == blank and product_resource.metafields.custom.size_guide_image != blank
    assign size_guide_image = product_resource.metafields.custom.size_guide_image
  endif
%}

{% if size_guide_image != blank %}
  <div class="ew-size-guide-block" {{ block.shopify_attributes }}>
    <button
      type="button"
      on:click="#ew-size-guide-{{ section.id }}/showDialog"
      class="button button-unstyled ew-size-guide-block__button link"
      aria-label="{{ 'products.product.size_guide' | t | default: 'Size guide' }}"
    >
      {{ 'products.product.size_guide' | t | default: 'Size guide' }}
    </button>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.size_guide",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.size_guide_uses_metafield"
    }
  ],
  "presets": [
    {
      "name": "t:names.size_guide",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
