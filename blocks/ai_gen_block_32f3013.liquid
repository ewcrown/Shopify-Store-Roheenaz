{% doc %}
  @prompt
    imgs block that are flex or each img have a differnt link within container or have 4 columns in 1 row on dextop view or 2 cloumn in mobile view
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-image-gallery-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-image-gallery-grid-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.image_spacing }}px;
    justify-content: {{ block.settings.alignment }};
  }

  .ai-image-gallery-item-{{ ai_gen_id }} {
    flex: 0 0 calc(25% - {{ block.settings.image_spacing | times: 3 | divided_by: 4 }}px);
    max-width: calc(25% - {{ block.settings.image_spacing | times: 3 | divided_by: 4 }}px);
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_lift | times: 2 }}px {{ block.settings.hover_lift | times: 4 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-image-gallery-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    position: relative;
  }

  .ai-image-gallery-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.image_height }}px;
    position: relative;
    overflow: hidden;
    background-color: #f5f5f5;
  }

  .ai-image-gallery-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover .ai-image-gallery-image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.hover_zoom }});
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
    color: #999;
    font-size: 14px;
  }

  .ai-image-gallery-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-image-gallery-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }

  .ai-image-gallery-item-{{ ai_gen_id }}:hover .ai-image-gallery-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-image-gallery-caption-{{ ai_gen_id }} {
    color: {{ block.settings.caption_color }};
    font-size: {{ block.settings.caption_size }}px;
    font-weight: 500;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  @media screen and (max-width: 1023px) {
    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - {{ block.settings.image_spacing | divided_by: 2 }}px);
      max-width: calc(50% - {{ block.settings.image_spacing | divided_by: 2 }}px);
    }
  }

  @media screen and (max-width: 767px) {
    .ai-image-gallery-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }

    .ai-image-gallery-item-{{ ai_gen_id }} {
      flex: 0 0 calc({{ block.settings.columns_mobile }}0% - {{ block.settings.image_spacing | divided_by: 2 }}px);
      max-width: calc({{ block.settings.columns_mobile }}0% - {{ block.settings.image_spacing | divided_by: 2 }}px);
    }

    .ai-image-gallery-image-wrapper-{{ ai_gen_id }} {
      height: {{ block.settings.image_height_mobile }}px;
    }

    .ai-image-gallery-overlay-{{ ai_gen_id }} {
      padding: 15px;
    }

    .ai-image-gallery-caption-{{ ai_gen_id }} {
      font-size: {{ block.settings.caption_size | minus: 2 }}px;
    }
  }

  {% if block.settings.show_empty_state %}
    .ai-image-gallery-empty-state-{{ ai_gen_id }} {
      text-align: center;
      padding: 60px 20px;
      color: #666;
    }

    .ai-image-gallery-empty-state-{{ ai_gen_id }} h3 {
      font-size: 24px;
      margin-bottom: 10px;
      color: #333;
    }

    .ai-image-gallery-empty-state-{{ ai_gen_id }} p {
      font-size: 16px;
      margin: 0;
    }
  {% endif %}
{% endstyle %}

<div class="ai-image-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-gallery-container-{{ ai_gen_id }}">
    {% assign has_images = false %}
    {% for i in (1..8) %}
      {% assign image_key = 'image_' | append: i %}
      {% assign link_key = 'link_' | append: i %}
      {% assign caption_key = 'caption_' | append: i %}
      
      {% if block.settings[image_key] != blank %}
        {% assign has_images = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_images %}
      <div class="ai-image-gallery-grid-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign link_key = 'link_' | append: i %}
          {% assign caption_key = 'caption_' | append: i %}
          
          {% assign current_image = block.settings[image_key] %}
          {% assign current_link = block.settings[link_key] %}
          {% assign current_caption = block.settings[caption_key] %}

          {% if current_image != blank %}
            <div class="ai-image-gallery-item-{{ ai_gen_id }}">
              {% if current_link != blank %}
                <a href="{{ current_link }}" class="ai-image-gallery-link-{{ ai_gen_id }}">
              {% else %}
                <div class="ai-image-gallery-link-{{ ai_gen_id }}">
              {% endif %}
                
                <div class="ai-image-gallery-image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ current_image | image_url: width: 800 }}"
                    alt="{{ current_image.alt | escape }}"
                    class="ai-image-gallery-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ current_image.width }}"
                    height="{{ current_image.height }}"
                  >
                  
                  {% if current_caption != blank and block.settings.show_captions %}
                    <div class="ai-image-gallery-overlay-{{ ai_gen_id }}">
                      <div class="ai-image-gallery-caption-{{ ai_gen_id }}">
                        {{ current_caption }}
                      </div>
                    </div>
                  {% endif %}
                </div>

              {% if current_link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      {% if block.settings.show_empty_state %}
        <div class="ai-image-gallery-empty-state-{{ ai_gen_id }}">
          <h3>Image Gallery</h3>
          <p>Add images to create your gallery</p>
        </div>
      {% endif %}
    {% endif %}
  </div>
</div>

