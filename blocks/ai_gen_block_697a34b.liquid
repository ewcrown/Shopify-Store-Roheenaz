{% doc %}
  @prompt
    imgs block that are flex or each img have a differnt link full width img or 3 imgs in 1 row
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-image-gallery-{{ ai_gen_id }}--flex {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .ai-image-gallery-{{ ai_gen_id }}--three-column {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.image_spacing }}px;
  }

  .ai-image-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-image-gallery-{{ ai_gen_id }}--flex .ai-image-item-{{ ai_gen_id }} {
    flex: 1;
    min-width: 0;
  }

  .ai-image-item-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .ai-image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .ai-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    overflow: hidden;
  }

  .ai-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-image-item-{{ ai_gen_id }}:hover .ai-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-image-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.5;
  }

  .ai-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-image-item-{{ ai_gen_id }}:hover .ai-image-overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-image-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    color: {{ block.settings.text_color }};
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-image-item-{{ ai_gen_id }}:hover .ai-image-content-{{ ai_gen_id }} {
    opacity: 1;
    transform: translateY(0);
  }

  .ai-image-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ai-image-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.4;
    opacity: 0.9;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
    font-size: 16px;
  }

  @media screen and (max-width: 768px) {
    .ai-image-gallery-{{ ai_gen_id }}--three-column {
      grid-template-columns: repeat({{ block.settings.mobile_columns }}, 1fr);
    }

    .ai-image-gallery-{{ ai_gen_id }}--flex {
      flex-direction: column;
    }

    .ai-image-content-{{ ai_gen_id }} {
      bottom: 15px;
      left: 15px;
      right: 15px;
    }

    .ai-image-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-image-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div
  class="ai-image-gallery-{{ ai_gen_id }} ai-image-gallery-{{ ai_gen_id }}--{{ block.settings.layout }}"
  {{ block.shopify_attributes }}
>
  {% assign has_images = false %}
  
  {% for i in (1..3) %}
    {% liquid
      assign image_key = 'image_' | append: i
      assign link_key = 'link_' | append: i
      assign title_key = 'title_' | append: i
      assign description_key = 'description_' | append: i
      
      assign image = block.settings[image_key]
      assign link = block.settings[link_key]
      assign title = block.settings[title_key]
      assign description = block.settings[description_key]
    %}
    
    {% if image != blank %}
      {% assign has_images = true %}
      <div class="ai-image-item-{{ ai_gen_id }}">
        {% if link != blank %}
          <a href="{{ link }}" class="ai-image-link-{{ ai_gen_id }}">
        {% endif %}
        
        <div class="ai-image-wrapper-{{ ai_gen_id }}">
          <img
            src="{{ image | image_url: width: 800 }}"
            alt="{{ image.alt | escape }}"
            class="ai-image-{{ ai_gen_id }}"
            loading="lazy"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
          
          {% if block.settings.show_overlay %}
            <div class="ai-image-overlay-{{ ai_gen_id }}"></div>
          {% endif %}
          
          {% if title != blank or description != blank %}
            <div class="ai-image-content-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-image-title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if description != blank %}
                <p class="ai-image-description-{{ ai_gen_id }}">{{ description }}</p>
              {% endif %}
            </div>
          {% endif %}
        </div>
        
        {% if link != blank %}
          </a>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
  
  {% unless has_images %}
    <div class="ai-empty-state-{{ ai_gen_id }}">
      <div class="ai-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
      <p>Add images to create your gallery</p>
    </div>
  {% endunless %}
</div>

{% schema %}
{
  "name": "Image gallery",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        {
          "value": "full-width",
          "label": "Full width (stacked)"
        },
        {
          "value": "flex",
          "label": "Flexible row"
        },
        {
          "value": "three-column",
          "label": "Three columns"
        }
      ],
      "default": "three-column"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "aspect_ratio",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "%",
      "label": "Image aspect ratio",
      "default": 75
    },
    {
      "type": "range",
      "id": "image_spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Space between images",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay on hover",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 20
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_1",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description_1",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_2",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image"
    },
    {
      "type": "url",
      "id": "link_3",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description_3",
      "label": "Description"
    }
  ],
  "presets": [
    {
      "name": "Image gallery"
    }
  ]
}
{% endschema %}