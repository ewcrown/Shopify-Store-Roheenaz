    "custom_liquid_W6JqNF": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n  const orderNote = document.getElementById('ai-order-note');\n  const variantField = document.querySelector('.variant-picker__field');\n\n  // Show/hide on page load based on selected value\n  if (variantField && variantField.getAttribute('data-selected-value') === 'Unstitched') {\n    orderNote.style.display = 'block';\n  } else {\n    orderNote.style.display = 'none';\n  }\n\n  // Handle future clicks/changes\n  document.querySelectorAll('.variant-picker__option').forEach(option => {\n    option.addEventListener('click', function () {\n      const value = this.getAttribute('data-value');\n\n      if (value === 'Unstitched') {\n        orderNote.style.display = 'block';\n        variantField.setAttribute('data-selected-value', 'Unstitched'); // Optional: Update attribute\n      } else {\n        orderNote.style.display = 'none';\n        variantField.setAttribute('data-selected-value', value); // Optional\n      }\n    });\n  });\n});\n</script>",
        "custom_class": ""
      }
