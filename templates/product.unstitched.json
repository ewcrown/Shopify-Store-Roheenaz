        },
        "custom_liquid_Jajggt": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<h2 class=\"acc_trigger\">DELIVERY TIMELINE </h2>\n    <div id=\"tab1\" class=\"acc_container\" style=\"display: block;\"> {% for tag in product.tags %}\n      {% if tag contains 'TDT' %}\n      {% assign TDT = tag | split: '--' %}\n      {% assign TDT = TDT[1] | strip %}\n      {% endif %}\n      {% endfor %}\n      {% if TDT %}\n      <div class=\"dinfo\"> {{ TDT }}</div>\n      {% endif %} </div>\n\t  \n\t<h2 class=\"acc_trigger\">CARE INSTRUCTIONS</h2>  \n    <div id=\"tab2\" class=\"acc_container\">\n      <div class=\"dinfo\">\n        <p>-Do not use any kind of bleach or stain removing chemicals<br>\n          -Do not over expose damp fabric to strong sunlight<br>\n          -Iron at moderate temperature<br>\n          -Do not wash at home</p>\n      </div>\n    </div>\n\t  \n\t<h2 class=\"acc_trigger\">DISCLAIMER</h2>  \n    <div id=\"tab3\" class=\"acc_container\"> {% for tag in product.tags %}\n      {% if tag contains 'DIS' %}\n      {% assign DIS = tag | split: '--' %}\n      {% assign DIS = DIS[1] | strip %}\n      {% endif %}\n      {% endfor %}\n      {% if DIS %}\n      <div class=\"dinfo\"> {{ DIS }}</div>\n      {% else %}\n      <div class=\"dinfo\">\n        <p>The fabric pattern/laces, patchwork, and handmade details may vary.<br>\n          Actual colors of the outfit may also vary from the colors being displayed on your device.</p>\n        <p>All laces used for finishing of the stitched outfit especially the dupatta or trousers may vary from the shoot.&nbsp;</p>\n      </div>\n      {% endif %} </div>\n  </div>\n\n<script src=\"https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js\"></script>\n<script>\n$(document).ready(function () {\n        //Add Inactive Class To All Accordion Headers\n        $('.acc_trigger').toggleClass('inactive-header');\n        $('.acc_trigger:first').addClass('active-header').next().show();\n        // The Accordion Effect\n        $('.acc_trigger').click(function () {\n            if ($(this).next().is(':hidden')) {\n                $('.active-header').toggleClass('active-header').toggleClass('inactive-header').next().slideToggle().toggleClass('open-content');\n                $(this).toggleClass('active-header').toggleClass('inactive-header');\n                $(this).next().slideToggle().toggleClass('open-content');\n            }\n\n            else {\n                $(this).toggleClass('active-header').toggleClass('inactive-header');\n                $(this).next().slideToggle().toggleClass('open-content');\n            }\n        });\n        return false;\n    });    </script>"
          }
        }
