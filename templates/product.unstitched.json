        "custom_liquid_6mgDeD": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{% for tag in product.tags %}\n        {% if tag contains 'TDT' %}\n            {% assign TDT = tag | split: '--' %}\n            {% assign TDT = TDT[1] | strip %}\n        {% endif %}\n        {% endfor %}\n        {% if TDT %}\n            <div class=\"dinfo\"> \n<h2 style=\"font-size: 18px;\">DELIVERY & RETURNS</h2>\n{{ TDT }}\n</div>\n        {% endif %}"
